From 58c1be61480a21099b517700c3eac155184733b2 Mon Sep 17 00:00:00 2001
From: sm64ds-3ds <244728604+ethanseagull@users.noreply.github.com>
Date: Tue, 20 Oct 2026 12:33:02 -0700
Subject: [PATCH] Revert "hal: the composite reports where its spans fell (a
 coverage grid)"

The 3DS card used the grid to draw its overlay's two full-screen passes
scissored to the covered cells. On hardware the scissor saves next to no GPU
time: each rectangle cost about a full-screen pass, and a dialogue's text
lines (10-14 rectangles) took the GPU to 16-26 ms a frame. The card no longer
draws by cells, so the grid has no reader.

This reverts commit 398d10e13.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 port/hal/message_compositor.cpp | 32 +-------------------------------
 1 file changed, 1 insertion(+), 31 deletions(-)

diff --git a/port/hal/message_compositor.cpp b/port/hal/message_compositor.cpp
index 56c5034be..6485ed907 100644
--- a/port/hal/message_compositor.cpp
+++ b/port/hal/message_compositor.cpp
@@ -860,23 +860,6 @@ inline bool winobj_off_env() {
 uint64_t g_pic_sig;
 bool g_pic_sig_ok;
 inline void pic_sig_add(uint32_t v) { g_pic_sig = (g_pic_sig ^ v) * 0x100000001B3ull; }
-/* AND WHERE THE SPANS FELL: one bit a host cell of 8 x 8 pixels (a word a band
-   of 8 rows, 64 cells across), set when a span touched it. With g_pic_sig_ok
-   every other pixel of the picture is the transparent fill, so the card draws
-   the overlay only over these cells (port_message_composite_cover). */
-constexpr int kCoverBands = 32;
-uint64_t g_pic_cover[kCoverBands];
-inline void pic_cover_add(int hx0, int hx1, int hy0, int hy1)
-{
-    if (hx0 < 0) hx0 = 0;
-    if (hy0 < 0) hy0 = 0;
-    if (hx1 > 64 * 8) hx1 = 64 * 8;
-    if (hy1 > kCoverBands * 8) hy1 = kCoverBands * 8;
-    if (hx1 <= hx0 || hy1 <= hy0) return;
-    const int c0 = hx0 >> 3, c1 = (hx1 - 1) >> 3;
-    const uint64_t m = (c1 - c0 == 63 ? ~0ull : ((1ull << (c1 - c0 + 1)) - 1)) << c0;
-    for (int b = hy0 >> 3; b <= (hy1 - 1) >> 3; ++b) g_pic_cover[b] |= m;
-}
 
 void hide_3d_outside_windows(uint32_t dispcnt, const Windows &w, ntr::Framebuffer &fb)
 {
@@ -3589,10 +3572,8 @@ bool memo_same(const MemoFrame &f)
 
 void memo_replay(ntr::Framebuffer &fb, MemoFrame &f)
 {
-    for (const MemoBlit &b : f.blits) {
+    for (const MemoBlit &b : f.blits)
         blit_ov_cell(fb, b.hx0, b.hx1 - b.hx0, b.hy0, b.hy1, b.word, false, 0);
-        pic_cover_add(b.hx0, b.hx1, b.hy0, b.hy1);
-    }
     g_bm_live = f.bm_live;
     g_bm_card = f.bm_card;
     g_bm_shown3d = f.bm_shown3d;
@@ -3682,7 +3663,6 @@ extern "C" void port_message_composite_engine_a(void *fbp)
     g_cz.begin(); g_cz.live = 0;
     g_pic_sig = 0xCBF29CE484222325ull;
     g_pic_sig_ok = true;
-    std::memset(g_pic_cover, 0, sizeof g_pic_cover);
     lc_overlay_begin();
     g_cz.live = (lc_ov.live || lc_ov.top_live) ? 1 : 0;
     g_cz.mark(0);
@@ -4551,7 +4531,6 @@ extern "C" void port_message_composite_engine_a(void *fbp)
         pic_sig_add((uint32_t)sp.hx0 | (uint32_t)sp.hx1 << 16);
         pic_sig_add((uint32_t)sp.hy0 | (uint32_t)sp.hy1 << 16);
         pic_sig_add(sp.word);
-        pic_cover_add(sp.hx0, sp.hx1, sp.hy0, sp.hy1);
         if (g_memo.rec) g_memo.cur_blits.push_back(MemoBlit{sp.hx0, sp.hx1, sp.hy0, sp.hy1, sp.word});
         blit_ov_cell(fb, sp.hx0, sp.hx1 - sp.hx0, sp.hy0, sp.hy1, sp.word, bm_on, sp.bits);
         sp.live = false;
@@ -4929,15 +4908,6 @@ extern "C" int port_message_composite_signature(unsigned long long *sig)
     return ok;
 }
 
-/* WHERE THE PICTURE COMPOSITED LAST HAS ANYTHING (g_pic_cover): 32 words, a
-   band of 8 host rows each, bit c the 8 columns from 8c. Meaningful only for a
-   composite whose signature was answered (port_message_composite_signature
-   said 1): every pixel outside these cells is then the transparent fill. */
-extern "C" void port_message_composite_cover(unsigned long long out[32])
-{
-    for (int b = 0; b < kCoverBands; ++b) out[b] = g_pic_cover[b];
-}
-
 /* THE PAUSE MENU COMPOSED ONCE (g_memo): a host that wants it says so once.
    Off, nothing of it runs but a counter. */
 extern "C" void port_message_composite_memo(int on)
-- 
