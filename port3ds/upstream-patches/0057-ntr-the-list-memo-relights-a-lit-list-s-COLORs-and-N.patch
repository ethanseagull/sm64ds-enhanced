From d32bebbe7f4a8683f6547d2f7b1384909ff5f1b9 Mon Sep 17 00:00:00 2001
From: sm64ds-3ds <244728604+ethanseagull@users.noreply.github.com>
Date: Sat, 24 Oct 2026 09:39:05 -0700
Subject: [PATCH] ntr: the list memo relights: a lit list's COLORs and NORMALs
 run at replay

A kept list with a NORMAL (and no normal-source texgen) keeps its COLORs
and NORMALs as live commands beside its MTX_RESTOREs: a replay runs them
in place, its vertices take g.color as it then is, and its key leaves the
colour and the lighting out. A lit model that animates, or that the
camera turns around, was a key miss every frame; it is now replayed. The
keys are compared word for word (a word-wise FNV let lightings differing
only in paired sign bits match).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 port/ntr/gx.cpp | 82 ++++++++++++++++++++++++++++++++++---------------
 1 file changed, 57 insertions(+), 25 deletions(-)

diff --git a/port/ntr/gx.cpp b/port/ntr/gx.cpp
index 9d5b8e99d..969e8c79f 100644
--- a/port/ntr/gx.cpp
+++ b/port/ntr/gx.cpp
@@ -2498,14 +2498,17 @@ int param_count(uint8_t cmd);   /* defined below; the trap needs it */
    state they read before writing it is what the list's key covers. A model's
    list picks its bones' matrices with MTX_RESTORE between its vertices: those
    run again at a replay (the matrices are this frame's), and the list is kept
-   as segments, one after each. */
+   as segments, one after each. A list with a NORMAL (and no normal-source
+   texgen) runs its COLORs and NORMALs again too, so its vertices take this
+   frame's lighting and its key leaves the lighting out: a lit model that
+   turns, or that the camera turns around, is still replayed. */
 enum { LM_R_COLOR = 1, LM_R_UV = 2, LM_R_VXYZ = 4, LM_R_LIGHT = 8, LM_R_TEXC = 16 };
 enum { LM_W_COLOR = 1, LM_W_UV = 2, LM_W_RAW = 4, LM_W_VXYZ = 8, LM_W_PRIM = 16, LM_W_NRM = 32,
        LM_W_PARITY = 64 };
 const uint8_t kLmCmds[] = {0x00, 0x20, 0x21, 0x22, 0x23, 0x24, 0x25, 0x26, 0x27, 0x28, 0x40, 0x41};
 enum { LM_NCMD = sizeof kLmCmds };
-enum { LM_MAX_LIVE = 64 };
-struct LmLive {             // an MTX_RESTORE and where it came
+struct LmLive {             // an MTX_RESTORE, COLOR or NORMAL and where it came
+    uint8_t cmd;
     uint32_t param;
     uint32_t v, t;          // the record's vertex and index counts then
 };
@@ -2517,8 +2520,8 @@ struct LmCap {
     uint32_t reads, writes;
     uint32_t cmd_n[LM_NCMD];
     uint32_t slots;   // the matrix stack slots its MTX_RESTOREs read
-    uint32_t nlive;
-    LmLive live[LM_MAX_LIVE];
+    int has_normal, texgen2;   // a NORMAL came; one under normal-source texgen
+    std::vector<LmLive> live;
 };
 LmCap g_lm;
 void lm_cap_abort();    // gx_write_fifo_n's section: a keeping ends unkept
@@ -2536,15 +2539,22 @@ inline void lm_vertex(bool partial) {
 void lm_note(uint8_t cmd, const uint32_t *p) {
     LmCap &c = g_lm;
     if (cmd == 0x14) {   // MTX_RESTORE: a live command, in position or position-vector mode
-        if ((g.mode != 1 && g.mode != 2) || c.nlive == LM_MAX_LIVE) {
+        if (g.mode != 1 && g.mode != 2) {
             if (!c.bad) c.bad_cmd = cmd;
             c.bad = 1;
             return;
         }
         c.slots |= 1u << (p[0] & 31);
-        c.live[c.nlive++] = LmLive{p[0], (uint32_t)g_rec.v.size(), (uint32_t)g_rec.idx.size()};
+        c.live.push_back(LmLive{cmd, p[0], (uint32_t)g_rec.v.size(), (uint32_t)g_rec.idx.size()});
         return;
     }
+    if (cmd == 0x20 || cmd == 0x21) {   // live too if the list turns out lit (lm_cap_end)
+        c.live.push_back(LmLive{cmd, p[0], (uint32_t)g_rec.v.size(), (uint32_t)g_rec.idx.size()});
+        if (cmd == 0x21) {
+            c.has_normal = 1;
+            if (((g_teximage >> 30) & 3) == 2) c.texgen2 = 1;
+        }
+    }
     int s = 0;
     while (s < LM_NCMD && kLmCmds[s] != cmd) ++s;
     if (s == LM_NCMD) {
@@ -3481,9 +3491,12 @@ struct LmEntry {
     std::vector<uint32_t> words;
     std::vector<RecVtx> v;            // the vertices (their id is the live one's at replay)
     std::vector<uint16_t> tri;        // corners, from the list's first vertex
-    // segment k: MTX_RESTORE live[k - 1] (none for the first), then vertices
-    // seg_v[k] .. seg_v[k + 1] and triangles seg_t[k] .. seg_t[k + 1] (corners)
+    // segment k: live command live_cmd[k - 1] (none for the first) with its
+    // parameter live[k - 1], then vertices seg_v[k] .. seg_v[k + 1] and
+    // triangles seg_t[k] .. seg_t[k + 1] (corners)
+    std::vector<uint8_t> live_cmd;
     std::vector<uint32_t> live, seg_v, seg_t;
+    uint8_t relit = 0;                // its COLORs and NORMALs are live: the vertices take g.color
     uint32_t slots = 0;
     std::vector<uint32_t> key;        // lm_key's words for the entry state it was kept under
     std::vector<uint32_t> strip;      // Rec::strip after it, the same way
@@ -3566,7 +3579,13 @@ void lm_cap_begin(LmEntry &e, const uint32_t *src, int n) {
     o.u = g.u; o.v = g.v; o.raw_u = g.raw_u; o.raw_v = g.raw_v;
     o.vx = g.vx; o.vy = g.vy; o.vz = g.vz;
     o.vec = g.vec;
-    g_lm = LmCap{};
+    {
+        std::vector<LmLive> live;
+        live.swap(g_lm.live);
+        live.clear();
+        g_lm = LmCap{};
+        g_lm.live.swap(live);
+    }
     g_lm.bad_cmd = -1;
     g_lm.on = 1;
     e.n = (uint32_t)n;
@@ -3600,18 +3619,20 @@ void lm_cap_end() {
     }
     // the segments; a segment's vertices all on one id, the live one at its
     // first vertex or one made there (so a replay makes it the same way)
-    e.live.resize(g_lm.nlive);
-    e.seg_v.resize(g_lm.nlive + 2);
-    e.seg_t.resize(g_lm.nlive + 2);
-    e.seg_v[0] = 0;
-    e.seg_t[0] = 0;
-    for (uint32_t k = 0; k < g_lm.nlive; ++k) {
-        e.live[k] = g_lm.live[k].param;
-        e.seg_v[k + 1] = g_lm.live[k].v - vbase;
-        e.seg_t[k + 1] = g_lm.live[k].t - ibase;
-    }
-    e.seg_v[g_lm.nlive + 1] = (uint32_t)R.v.size() - vbase;
-    e.seg_t[g_lm.nlive + 1] = (uint32_t)R.idx.size() - ibase;
+    e.relit = g_lm.has_normal && !g_lm.texgen2;
+    e.live_cmd.clear();
+    e.live.clear();
+    e.seg_v.assign(1, 0);
+    e.seg_t.assign(1, 0);
+    for (const LmLive &l : g_lm.live) {
+        if (l.cmd != 0x14 && !e.relit) continue;
+        e.live_cmd.push_back(l.cmd);
+        e.live.push_back(l.param);
+        e.seg_v.push_back(l.v - vbase);
+        e.seg_t.push_back(l.t - ibase);
+    }
+    e.seg_v.push_back((uint32_t)R.v.size() - vbase);
+    e.seg_t.push_back((uint32_t)R.idx.size() - ibase);
     e.slots = g_lm.slots;
     size_t ids = o.mtx_n;
     for (uint32_t k = 0; k + 1 < e.seg_v.size(); ++k) {
@@ -3637,6 +3658,12 @@ void lm_cap_end() {
     std::memcpy(e.cmd_n, g_lm.cmd_n, sizeof e.cmd_n);
     e.reads = g_lm.reads;
     e.writes = g_lm.writes;
+    if (e.relit) {
+        // exec counts them at a replay, and they make the colour from this
+        // frame's state: no colour or lighting in the key
+        e.cmd_n[1] = e.cmd_n[2] = 0;   // kLmCmds: COLOR, NORMAL
+        e.reads &= ~(uint32_t)(LM_R_COLOR | LM_R_LIGHT);
+    }
     e.vx = g.vx; e.vy = g.vy; e.vz = g.vz;
     e.prim = g.prim;
     e.normal_live = g.normal_live;
@@ -3662,7 +3689,8 @@ void lm_replay(const LmEntry &e) {
     const uint32_t vbase = (uint32_t)R.v.size();
     R.v.reserve(vbase + e.v.size());
     for (size_t k = 0; k + 1 < e.seg_v.size(); ++k) {
-        if (k) exec(0x14, &e.live[k - 1], 1);   // MTX_RESTORE, with this frame's matrices
+        // MTX_RESTORE with this frame's matrices; COLOR or NORMAL with its lighting
+        if (k) exec(e.live_cmd[k - 1], &e.live[k - 1], 1);
         const uint32_t v0 = e.seg_v[k], v1 = e.seg_v[k + 1];
         if (v0 != v1) {
             // vertex(): the segment's first vertex's matrix id
@@ -3676,9 +3704,11 @@ void lm_replay(const LmEntry &e) {
             const size_t at = R.v.size();
             R.v.resize(at + (v1 - v0));
             RecVtx *out = R.v.data() + at;
+            const uint32_t color = g.color;
             for (uint32_t x = v0; x < v1; ++x) {
                 *out = e.v[x];
                 out->id = id;
+                if (e.relit) out->color = color;
                 ++out;
             }
             if (g_rec_id_stats) {
@@ -3702,8 +3732,10 @@ state:
         g.strip_raw.clear();
     }
     if (e.writes & LM_W_PARITY) g.strip_parity = e.parity;
-    if (e.writes & (LM_W_COLOR | LM_W_NRM)) { g.color = e.color; g.normal_live = e.normal_live; }
-    if (e.writes & LM_W_NRM) std::memcpy(g.nrm, e.nrm, sizeof e.nrm);
+    if (!e.relit) {   // a relit list's COLORs and NORMALs ran
+        if (e.writes & (LM_W_COLOR | LM_W_NRM)) { g.color = e.color; g.normal_live = e.normal_live; }
+        if (e.writes & LM_W_NRM) std::memcpy(g.nrm, e.nrm, sizeof e.nrm);
+    }
     if (e.writes & LM_W_UV) { g.u = e.u; g.v = e.v_; }
     if (e.writes & LM_W_RAW) { g.raw_u = e.raw_u; g.raw_v = e.raw_v; }
     for (int s = 0; s < LM_NCMD; ++s) g_cmd_n[kLmCmds[s]] += e.cmd_n[s];
-- 
