From d2d3347267591922207a6c7961e252c7cc4caea8 Mon Sep 17 00:00:00 2001
From: sm64ds-3ds <244728604+ethanseagull@users.noreply.github.com>
Date: Sat, 17 Oct 2026 05:40:12 -0700
Subject: [PATCH] hal: engine A compositor per-pixel work, cut without changing
 a pixel

- hudelem::resolve (widescreen only): skips g_a_clean rows; the passes run
  over the rows within kBridgeY of a mark (not the whole band from the first
  mark to the last); the vertical dilation sweeps a row at a time with a run
  per column. Same labels and anchors (checked against the old function on
  every frame of the 3DS widescreen regression runs: 0 differences).
- The BG loop reads each tile's screen entry once per run of its pixels and
  the BG palette from a table expanded once a frame (sample_bg_at). Checked
  with SM64DS_TWOD_VERIFY=1: 0 mismatching composites.
- hide_3d_outside_windows: each host column's DS column from a table built
  once per call (it was a call to present_h() and a divide per host pixel).
- The final blit: ds_col_x0 / ds_row_y0 from tables built once a frame.
- bm_fill_default: the card verdict from a 64-entry table, and a row whose
  window mask is the last built row's is copied.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 port/hal/message_compositor.cpp | 165 +++++++++++++++++++++++++-------
 1 file changed, 133 insertions(+), 32 deletions(-)

diff --git a/port/hal/message_compositor.cpp b/port/hal/message_compositor.cpp
index ccf71a089..1fac46462 100644
--- a/port/hal/message_compositor.cpp
+++ b/port/hal/message_compositor.cpp
@@ -484,6 +484,39 @@ bool sample_bg(const BgConfig &c, int x, int y, uint32_t &out) {
     return true;
 }
 
+// sample_bg for the BG loop: the same answer, with the line's map row and the
+// last screen entry kept between calls (a tile's 8 pixels share one) and the
+// palette read from pal32, the standard BG palette expanded once a frame.
+struct BgCursor { int py = 0; int tx = -1; uint16_t se = 0; };
+inline void bg_cursor_line(const BgConfig &c, int y, BgCursor &k) {
+    k.py = (y + c.vofs) & (c.tiles_h * 8 - 1);
+    k.tx = -1;
+}
+inline bool sample_bg_at(const BgConfig &c, BgCursor &k, int x, const uint32_t *pal32,
+                         uint32_t &out) {
+    const int px = (x + c.hofs) & (c.tiles_w * 8 - 1);
+    const int tx = px >> 3;
+    if (tx != k.tx) { k.tx = tx; k.se = rd16(screen_entry_addr(c, tx, k.py >> 3)); }
+    const uint16_t se = k.se;
+    const int tile = se & 0x3FF;
+    int fx = px & 7, fy = k.py & 7;
+    if (se & 0x400) fx = 7 - fx;
+    if (se & 0x800) fy = 7 - fy;
+    uint32_t index;
+    if (c.bpp8) {
+        index = *reinterpret_cast<volatile uint8_t *>(c.chars + tile * 64 + fy * 8 + fx);
+        if (index == 0) return false;
+    } else {
+        const uint8_t pair =
+            *reinterpret_cast<volatile uint8_t *>(c.chars + tile * 32 + fy * 4 + (fx >> 1));
+        index = (fx & 1) ? (pair >> 4) : (pair & 0xF);
+        if (index == 0) return false;
+        index += ((se >> 12) & 0xF) * 16;
+    }
+    out = pal32[index];
+    return true;
+}
+
