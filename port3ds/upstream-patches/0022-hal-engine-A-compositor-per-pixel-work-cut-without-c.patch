+    // over the near rows only; across a far row every column's run is already
+    // past kBridgeY, which is where a sweep restarts it.
+    bool near[192];
+    {
+        int last = -1000;
+        for (int y = 0; y < 192; ++y) { if (marked[y]) last = y; near[y] = y - last <= kBridgeY; }
