From acc2c00563e42d4b14d06a4b2360df75277af163 Mon Sep 17 00:00:00 2001
From: sm64ds-3ds <244728604+ethanseagull@users.noreply.github.com>
Date: Thu, 15 Oct 2026 17:09:49 -0700
Subject: [PATCH] ntr: DS fog in the software raster, and the frame's fog for a
 card

The 3D engine's fog was not drawn at all. gx_fog_state reads DISP3DCNT's
fog bits, FOG_COLOR, FOG_OFFSET, FOG_TABLE and the rear plane's fog bit
and depth; gx_fog_density is melonDS's lookup in 15-bit depth units (z *
0x7FFF for a Z frame, w * 8 for a W frame). Each triangle carries
POLYGON_ATTR bit 15 (GxTriangle::fog, in what was padding); a per-pixel
fog flag follows the attribute word's rules (opaque sets it, translucent
clears it unless fogged too, the clear sets the rear plane's), and
fog_pass blends every flagged pixel after the translucent pass.
GxGpuFrame::fog hands a whole-frame backend the same state.

SM64DS_FOG_PROBE=1 logs the state on change; SM64DS_FOG_FORCE=<shift>,
<offset hex> forces it on over the stage's own table (a test: the
shipped levels fog only in Hazy Maze Cave and under water).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 port/ntr/gx.cpp           | 159 +++++++++++++++++++++++++++++++++++++-
 port/ntr/include/ntr/gx.h |  38 +++++++++
 2 files changed, 196 insertions(+), 1 deletion(-)

diff --git a/port/ntr/gx.cpp b/port/ntr/gx.cpp
index f8bbc41e5..6dc7bc95d 100644
--- a/port/ntr/gx.cpp
+++ b/port/ntr/gx.cpp
@@ -829,6 +829,7 @@ static inline void fill_tri_state(GxTriangle &t) {
     t.mode = static_cast<uint8_t>((g.poly_attr >> 4) & 3);
     t.polyid = static_cast<uint8_t>((g.poly_attr >> 24) & 63);
     t.depth_eq = static_cast<uint8_t>((g.poly_attr >> 14) & 1);
+    t.fog = static_cast<uint8_t>((g.poly_attr >> 15) & 1);
     t.wrap = g.tex_wrap;
     /* TEXIMAGE_PARAM bits 26-28 are the format; 1 (A3I5) and 6 (A5I3)
        are the two translucent-texture formats. Attr alpha 0 is wire and
@@ -3912,6 +3913,13 @@ MaskRow *g_cover;
 MaskRow *g_stencil;
 MaskRow *g_attrid;
 MaskRow *g_tlattr;
+/* THE FOG FLAG, the DS attribute word's bit 15: 1 where the pixel is fogged
+   (see GxFog in ntr/gx.h). An opaque write sets it from its polygon, a
+   translucent one clears it unless its polygon has fog too, the clear sets
+   it from CLEAR_COLOR bit 15. Touched only on a frame with fog. */
+MaskRow *g_fogflag;
+GxFog g_fog;
+bool g_have_fog;
 
 /* True once every buffer is there. A refusal is FATAL and says so: a renderer
    with nowhere to put a depth value cannot draw a frame, and a program that
@@ -3953,7 +3961,8 @@ bool raster_buffers(void)
     g_stencil = (MaskRow *)std::calloc(SCREEN_H, sizeof(MaskRow));
     g_attrid = (MaskRow *)std::calloc(SCREEN_H, sizeof(MaskRow));
     g_tlattr = (MaskRow *)std::calloc(SCREEN_H, sizeof(MaskRow));
-    if (g_depth && g_cover && g_stencil && g_attrid && g_tlattr) return true;
+    g_fogflag = (MaskRow *)std::calloc(SCREEN_H, sizeof(MaskRow));
+    if (g_depth && g_cover && g_stencil && g_attrid && g_tlattr && g_fogflag) return true;
     std::fprintf(stderr,
                  "FATAL: the 3D renderer could not get its %d x %d buffers "
                  "(about %.1f MB). There is not enough memory to draw.\n",
@@ -4084,6 +4093,106 @@ int gx_toon_table(float rgb[32 * 3])
     return (d3 & 2u) ? 2 : 1;
 }
 
+int gx_fog_state(GxFog *out)
+{
+    std::memset(out, 0, sizeof *out);
+    if (!io_ready()) return 0;
+    uint16_t d3 = *reinterpret_cast<const volatile uint16_t *>(0x04000060u);
+    /* SM64DS_FOG_FORCE=<shift>,<offset hex>: fog on whatever the stage set,
+       with that shift and offset (a test: the shipped levels fog only under
+       water). The table and colour are the ones Stage::RenderFog wrote. */
+    static int force_shift = -2, force_offset = 0;
+    if (force_shift == -2) {
+        const char *e = std::getenv("SM64DS_FOG_FORCE");
+        force_shift = -1;
+        if (e && *e) {
+            force_shift = std::atoi(e) & 15;
+            const char *c = std::strchr(e, ',');
+            force_offset = c ? (int)(std::strtoul(c + 1, nullptr, 16) & 0x7FFF) : 0;
+        }
+    }
+    if (force_shift >= 0) d3 = (uint16_t)((d3 & ~0x0F40u) | 0x80u | (force_shift << 8));
+    if (!(d3 & 0x80u)) return 0;
+    out->enabled = 1;
+    out->alpha_only = (d3 >> 6) & 1;
+    out->shift = (d3 >> 8) & 15;
+    const uint32_t fc = *reinterpret_cast<const volatile uint32_t *>(0x04000358u);
+    out->color_argb = 0xFF000000u | bgr555_to_argb(static_cast<uint16_t>(fc & 0x7FFF));
+    out->color_a = static_cast<int>((fc >> 16) & 31);
+    out->offset = force_shift >= 0
+                      ? force_offset
+                      : *reinterpret_cast<const volatile uint16_t *>(0x0400035Cu) & 0x7FFF;
+    const volatile uint8_t *tb = reinterpret_cast<const volatile uint8_t *>(0x04000360u);
+    for (int i = 0; i < 32; ++i) out->table[i] = static_cast<uint8_t>(tb[i] & 0x7F);
+    const uint32_t cc = *reinterpret_cast<const volatile uint32_t *>(0x04000350u);
+    out->rear_fog = static_cast<int>((cc >> 15) & 1);
+    out->rear_depth = *reinterpret_cast<const volatile uint16_t *>(0x04000354u) & 0x7FFF;
+    return 1;
+}
+
+/* melonDS SoftRenderer's fog lookup, in 15-bit depth units: its density table
+   is FOG_TABLE with entry 0 repeated in front and entry 31 behind, so entry n
+   is reached one step past FOG_OFFSET + (n * 0x400 >> shift). */
+int gx_fog_density(const GxFog &f, int depth15)
+{
+    const int rel = depth15 - f.offset;
+    int den;
+    if (rel < 0) {
+        den = f.table[0];
+    } else {
+        const int64_t pos = (static_cast<int64_t>(rel) << f.shift) - 0x400;
+        if (pos < 0) {
+            den = f.table[0];
+        } else {
+            const int64_t idx = pos >> 10;
+            if (idx >= 31) {
+                den = f.table[31];
+            } else {
+                const int frac = static_cast<int>(pos & 0x3FF);
+                den = (f.table[idx] * (0x400 - frac) + f.table[idx + 1] * frac) >> 10;
+            }
+        }
+    }
+    return den >= 127 ? 128 : den;
+}
+
+/* The fog, after both passes and before the edge smoothing: every flagged
+   pixel toward FOG_COLOR by its depth's density. The framebuffer carries no
+   3D alpha, so an alpha-only fog changes nothing here. */
+static void fog_pass(Framebuffer &fb, int cw, int ch)
+{
+    const GxFog &f = g_fog;
+    if (f.alpha_only) return;
+    const bool wd = g_wdepth;
+    const int fr = (int)((f.color_argb >> 16) & 0xFF), fg = (int)((f.color_argb >> 8) & 0xFF),
+              fbl = (int)(f.color_argb & 0xFF);
+    for (int y = 0; y < ch; ++y) {
+        const uint8_t *fl = g_fogflag[y];
+        const float *dr = g_depth[y];
+        uint32_t *row = fb.px[y];
+        for (int x = 0; x < cw; ++x) {
+            if (!fl[x]) continue;
+            const float d = dr[x];
+            int d15;
+            if (d >= 1e29f) {
+                d15 = f.rear_depth;
+            } else {
+                float v = wd ? (d < 0.0f ? -8.0f / d : 32767.0f) : d * 32767.0f;
+                d15 = v <= 0.0f ? 0 : v >= 32767.0f ? 32767 : (int)v;
+            }
+            const int den = gx_fog_density(f, d15);
+            if (!den) continue;
+            const uint32_t c = row[x];
+            const int r = (int)((c >> 16) & 0xFF), gg = (int)((c >> 8) & 0xFF),
+                      b = (int)(c & 0xFF);
+            row[x] = (c & 0xFF000000u) |
+                     (uint32_t)((fr * den + r * (128 - den)) >> 7) << 16 |
+                     (uint32_t)((fg * den + gg * (128 - den)) >> 7) << 8 |
+                     (uint32_t)((fbl * den + b * (128 - den)) >> 7);
+        }
+    }
+}
+
 uint32_t gx_clear_argb()
 {
     static const int old = std::getenv("SM64DS_CLEAR_FILL_OLD") ? 1 : 0;
@@ -5399,6 +5508,7 @@ void raster_ref(const RefArgs &ra, int tid, int nt) {
     const bool want_id = ra.want_id;
     const int pass_lo = ra.pass_lo, pass_hi = ra.pass_hi;
     const bool wdepth = g_wdepth;
+    const bool have_fog = g_have_fog;
     DepthRow *const depth = g_depth;
     MaskRow *const stencil = g_stencil;
     MaskRow *const attrid = g_attrid;
@@ -5617,6 +5727,7 @@ void raster_ref(const RefArgs &ra, int tid, int nt) {
             uint32_t *frow = fb.px[y];
             uint8_t *irow = attrid[y];
             uint8_t *trow = tlattr[y];
+            uint8_t *const fgrow = g_fogflag[y];
             for (int x = minx; x <= maxx; ++x) {
                 const float px = x + 0.5f;
                 /* Coverage is decided on the undivided edge functions. The
@@ -5717,6 +5828,7 @@ void raster_ref(const RefArgs &ra, int tid, int nt) {
                        translucent-CLASS triangle whose per-pixel alpha came out
                        31: an A3I5 or A5I3 texel at full opacity. */
                     if (have_translucent) trow[x] = 0;
+                    if (have_fog) fgrow[x] = t.fog;
                 } else {
                     /* translucent: blend over the framebuffer, keep depth
                        (DS translucent polys depth-test but do not write).
@@ -5727,6 +5839,7 @@ void raster_ref(const RefArgs &ra, int tid, int nt) {
                         static_cast<uint8_t>(0x40 | t.polyid);
                     if (trow[x] == tl) continue;
                     trow[x] = tl;
+                    if (have_fog) fgrow[x] &= t.fog;
                     const uint32_t dst = frow[x];
                     auto bl = [&](int k, int sh) {
                         const uint32_t s = ch(k, sh);
@@ -6237,6 +6350,38 @@ void gx_render(Framebuffer &fb) {
        card fell back, or declined) carries on below exactly as it always did,
        and the opaque-only call at the seam is still there for it. With no
        backend registered, and in the A/B, none of this runs. */
+    /* THE FRAME'S FOG: on when DISP3DCNT says so and something takes it */
+    g_have_fog = false;
+    if (gx_fog_state(&g_fog)) {
+        g_have_fog = g_fog.rear_fog != 0;
+        for (size_t i = 0; i < g.tris.size() && !g_have_fog; ++i)
+            g_have_fog = g.tris[i].fog != 0;
+    }
+    {
+        static const int fprobe = std::getenv("SM64DS_FOG_PROBE") ? 1 : 0;
+        static uint32_t flast = 1;
+        if (fprobe) {
+            uint32_t h = 2166136261u;
+            const uint8_t *pb = reinterpret_cast<const uint8_t *>(&g_fog);
+            for (size_t i = 0; i < sizeof g_fog; ++i) h = (h ^ pb[i]) * 16777619u;
+            h ^= g_have_fog ? 0x80000000u : 0u;
+            if (h != flast) {
+                flast = h;
+                size_t nf = 0;
+                for (const GxTriangle &t : g.tris) nf += t.fog;
+                std::fprintf(stderr,
+                             "[fog] %s: %zu of %zu triangles, %s depth, alpha_only %d shift %d "
+                             "color %08x a %d offset %04x rear %d/%04x table %02x %02x %02x "
+                             "%02x .. %02x %02x\n",
+                             g_have_fog ? "on" : (g_fog.enabled ? "enabled, unused" : "off"),
+                             nf, g.tris.size(), frame_wdepth() ? "W" : "Z", g_fog.alpha_only,
+                             g_fog.shift, (unsigned)g_fog.color_argb, g_fog.color_a,
+                             g_fog.offset, g_fog.rear_fog, g_fog.rear_depth, g_fog.table[0],
+                             g_fog.table[1], g_fog.table[2], g_fog.table[3], g_fog.table[30],
+                             g_fog.table[31]);
+            }
+        }
+    }
     int gpu_drew = 0;
     /* 1 when the card drew the translucent and shadow pass as well (and maybe
        the edge smoothing: gpu_out.aa_done), so neither CPU pass runs below */
@@ -6284,6 +6429,7 @@ void gx_render(Framebuffer &fb) {
                        : (cw > 0 && ch > 0) ? fb.px[f.py0][f.px0] : 0xFF000000u;
         f.toon_shade = g_toon_shade;
         f.toon_rgb = g_toon8;
+        f.fog = g_have_fog ? &g_fog : nullptr;
         f.full_ok = 2;
         f.out = &gpu_out;
         f.keep = g_cp_pending;
@@ -6330,6 +6476,9 @@ void gx_render(Framebuffer &fb) {
         }
         if (have_translucent)
             for (int y = 0; y < ch; ++y) std::memset(tlattr[y], 0, (size_t)cw);
+        if (g_have_fog)
+            for (int y = 0; y < ch; ++y)
+                std::memset(g_fogflag[y], g_fog.rear_fog ? 1 : 0, (size_t)cw);
     }
 
     /* SM64DS_TEX_ONLY=<hex teximage>: draw only the polygons that were
@@ -6429,6 +6578,7 @@ void gx_render(Framebuffer &fb) {
        instruction stream it was before filtering existed. */
     constexpr int FILTER = decltype(ftag)::value;
     const bool wdepth = g_wdepth;
+    const bool have_fog = g_have_fog;
     /* This tile's rows. */
     const int ty0 = tile * tile_h;
     const int ty1 = (ty0 + tile_h < SCREEN_H ? ty0 + tile_h : SCREEN_H) - 1;
@@ -6674,6 +6824,7 @@ void gx_render(Framebuffer &fb) {
             uint32_t *frow = fb.px[y];
             uint8_t *irow = attrid[y];
             uint8_t *trow = tlattr[y];
+            uint8_t *const fgrow = g_fogflag[y];
             int xs = minx, xe = maxx;
             const bool sp_ok = !use_span || row_span(st, r0, r1, r2, minx, maxx, xs, xe);
             if (big_tri && !big_row(a, b, c, py, minx, maxx, sp_ok, xs, xe))
@@ -6780,6 +6931,7 @@ void gx_render(Framebuffer &fb) {
                        translucent-CLASS triangle whose per-pixel alpha came out
                        31: an A3I5 or A5I3 texel at full opacity. */
                     if (have_translucent) trow[x] = 0;
+                    if (have_fog) fgrow[x] = t.fog;
                 } else {
                     /* translucent: blend over the framebuffer, keep depth
                        (DS translucent polys depth-test but do not write).
@@ -6790,6 +6942,7 @@ void gx_render(Framebuffer &fb) {
                         static_cast<uint8_t>(0x40 | t.polyid);
                     if (trow[x] == tl) continue;
                     trow[x] = tl;
+                    if (have_fog) fgrow[x] &= t.fog;
                     const uint32_t dst = frow[x];
                     auto bl = [&](int k, int sh) {
                         const uint32_t s = ch(k, sh);
@@ -7011,6 +7164,7 @@ void gx_render(Framebuffer &fb) {
         /* the frame's toon table, for its mode-2 polygons (0 = none) */
         f.toon_shade = g_toon_shade;
         f.toon_rgb = g_toon8;
+        f.fog = g_have_fog ? &g_fog : nullptr;
         /* THE WHOLE-FRAME HAND-OVER (run cardfull). A backend that can draw the
            second pass says so by returning 2; one that cannot returns 1 or 0
            and nothing below changes. The smoothing is offered to it only
@@ -7310,6 +7464,9 @@ void gx_render(Framebuffer &fb) {
 
     /* the second pass: skipped when the card drew it (run cardfull) */
     if (!gpu_full) run_checked(gpu_drew ? 1 : 0, 1);
+    /* fog, over a frame the processor drew (a card that drew only the opaque
+       pass left no fog flags here, so that frame goes unfogged) */
+    if (!gpu_full && !gpu_drew && g_have_fog) fog_pass(fb, cw, ch);
 
     if (tm) t_pass1 = std::chrono::steady_clock::now();
 
diff --git a/port/ntr/include/ntr/gx.h b/port/ntr/include/ntr/gx.h
index ae40d5046..2d941f816 100644
--- a/port/ntr/include/ntr/gx.h
+++ b/port/ntr/include/ntr/gx.h
@@ -100,9 +100,43 @@ struct GxTriangle {
     // POLYGON_ATTR bit 14: this polygon's depth test is EQUAL (within the
     // hardware's tolerance) instead of LESS. See w_depth_fail in gx.cpp.
     uint8_t depth_eq;
+    // POLYGON_ATTR bit 15: this polygon takes the frame's fog (see GxFog).
+    // It sits in what was padding, so the record's size is unchanged.
+    uint8_t fog;
     uint32_t dbg_tex;      // TEXIMAGE_PARAM that was bound (diagnostics only)
 };
 
+// ---- THE FRAME'S FOG (DISP3DCNT bits 6-11, FOG_COLOR, FOG_OFFSET, FOG_TABLE)
+//
+// The DS fogs after the frame is drawn: each pixel whose fog flag is set (the
+// opaque polygon's POLYGON_ATTR bit 15, cleared by a translucent polygon
+// without it; the rear plane's from CLEAR_COLOR bit 15) is blended toward
+// FOG_COLOR by a density looked up from its depth. The depth is the DS's
+// 15-bit one (the 24-bit depth buffer's top bits): z * 0x7FFF for a Z frame,
+// w * 8 (w in raw 1/4096 units, >> 9, saturating) for a W frame. Entry n of
+// the table sits at FOG_OFFSET + (n * 0x400 >> shift); before entry 0 the
+// density is entry 0's, past entry 31 it is entry 31's, between two entries
+// it is interpolated; 127 means 128 (all fog). gx_fog_density computes it.
+// The game sets it every frame from the stage (Stage::RenderFog).
+struct GxFog {
+    int enabled;           // DISP3DCNT bit 7
+    int alpha_only;        // DISP3DCNT bit 6: only the alpha is fogged
+    int shift;             // DISP3DCNT bits 8-11
+    uint32_t color_argb;   // FOG_COLOR as 0xFFRRGGBB
+    int color_a;           // FOG_COLOR bits 16-20 (0..31)
+    int offset;            // FOG_OFFSET, 0..0x7FFF
+    uint8_t table[32];     // FOG_TABLE, 0..127 each
+    int rear_fog;          // CLEAR_COLOR bit 15: the rear plane is fogged
+    int rear_depth;        // CLEAR_DEPTH, 0..0x7FFF
+};
+
+// The frame's fog registers into *out; 1 when fog is on, 0 (and *out
+// zeroed) when it is off or there is no I/O.
+int gx_fog_state(GxFog *out);
+
+// Density 0..128 at a 15-bit DS depth.
+int gx_fog_density(const GxFog &f, int depth15);
+
 // ---- A SMOOTHED TRIANGLE'S GRID, KEPT WHOLE FOR THE CARD (run hunt8, SMOOTHGPU1)
 //
 // With SmoothModels on, one source triangle becomes a grid of up to 64
@@ -299,6 +333,10 @@ struct GxGpuFrame {
     // per entry, in the units the vertex colour travels in.
     int toon_shade;
     const float *toon_rgb;
+    // THE FRAME'S FOG, or null when it has none (fog off, or no polygon with
+    // its fog bit). See GxFog; the software pass applies it after the
+    // translucent pass, so a backend that draws the frame whole does too.
+    const GxFog *fog;
 
     // ---- THE WHOLE FRAME ON THE CARD (run cardfull, lane CARDFULL1) ---------
     // Everything below is for a backend that draws the translucent and shadow
