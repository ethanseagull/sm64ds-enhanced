From 78c5fe7a18cce3a25b1e4708e08d3f68509335b9 Mon Sep 17 00:00:00 2001
From: sm64ds-3ds <244728604+ethanseagull@users.noreply.github.com>
Date: Tue, 13 Oct 2026 16:46:34 -0700
Subject: [PATCH 01/13] types.h: take the host size_t on the 3DS port build too

GCC for ARM (devkitARM) spells size_t as unsigned int, like 32-bit MSVC,
and rejects the unsigned long typedef as a conflicting declaration. Guarded
on SM64DS_HOST_3DS, so mwccarm never sees the change and no ROM byte moves.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/types.h | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/include/types.h b/include/types.h
index 5d4c237ae..e713f7a93 100644
--- a/include/types.h
+++ b/include/types.h
@@ -20,8 +20,9 @@ typedef signed long long   s64;
    MSVC rejects `operator new(unsigned long)` with C2821, "first formal
    parameter to 'operator new' must be 'size_t'". Neither arm below is visible
    to the other compiler, so no ROM byte moves: mwccarm keeps the `unsigned
-   long` the nine actor headers already declared. */
-#ifdef _MSC_VER
+   long` the nine actor headers already declared. The New 3DS port (GCC,
+   SM64DS_HOST_3DS) is a host in the same sense: its size_t is `unsigned int`. */
+#if defined(_MSC_VER) || defined(SM64DS_HOST_3DS)
 #include <stddef.h>          /* the host's own size_t, so the host rule holds by definition */
 #else
 typedef unsigned long size_t;
