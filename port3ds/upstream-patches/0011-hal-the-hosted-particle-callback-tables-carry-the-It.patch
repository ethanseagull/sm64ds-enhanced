+void *_ZTVN5dPa_c7level_c16bubbleCallback_cE[VT_HEAD + 2] = {
+    VT_HEAD_WORDS SPAWN(_ZN5dPa_c7level_c16simpleCallback_c14SpawnParticlesERN8Particle6SystemE),
