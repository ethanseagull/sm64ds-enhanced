 inline uint32_t rec_id(const RecVtx &v) { return v.id & 0x7FFFu; }
@@ -2480,9 +2491,88 @@ void mtx_load_log(uint8_t cmd, const uint32_t *p) {
 
 int param_count(uint8_t cmd);   /* defined below; the trap needs it */
 
+/* THE LIST MEMO'S CAPTURE (gx_list_memo, at gx_write_fifo_n): while a display
+   list runs the ordinary way to be kept, exec notes each command here: the
+   memo replays only lists of BEGIN / END, the vertices, COLOR, NORMAL,
+   TEXCOORD, NOP and MTX_RESTORE (no state a run keeps), and what of the entry
+   state they read before writing it is what the list's key covers. A model's
+   list picks its bones' matrices with MTX_RESTORE between its vertices: those
+   run again at a replay (the matrices are this frame's), and the list is kept
+   as segments, one after each. */
+enum { LM_R_COLOR = 1, LM_R_UV = 2, LM_R_VXYZ = 4, LM_R_LIGHT = 8, LM_R_TEXC = 16 };
+enum { LM_W_COLOR = 1, LM_W_UV = 2, LM_W_RAW = 4, LM_W_VXYZ = 8, LM_W_PRIM = 16, LM_W_NRM = 32,
+       LM_W_PARITY = 64 };
+const uint8_t kLmCmds[] = {0x00, 0x20, 0x21, 0x22, 0x23, 0x24, 0x25, 0x26, 0x27, 0x28, 0x40, 0x41};
+enum { LM_NCMD = sizeof kLmCmds };
+enum { LM_MAX_LIVE = 64 };
+struct LmLive {             // an MTX_RESTORE and where it came
+    uint32_t param;
+    uint32_t v, t;          // the record's vertex and index counts then
+};
+struct LmCap {
+    int on;
+    int bad;          // a command the memo does not replay, or a vertex before BEGIN / END
+    int prim_known;   // a BEGIN or END came: the vertices' primitive is the list's own
+    int bad_cmd;      // the first command it does not replay (-1: none)
+    uint32_t reads, writes;
+    uint32_t cmd_n[LM_NCMD];
+    uint32_t slots;   // the matrix stack slots its MTX_RESTOREs read
+    uint32_t nlive;
+    LmLive live[LM_MAX_LIVE];
+};
+LmCap g_lm;
+void lm_cap_abort();    // gx_write_fifo_n's section: a keeping ends unkept
+void lm_frame_reset();  // gx_reset: nothing open or pending across frames
+
+inline void lm_vertex(bool partial) {
+    LmCap &c = g_lm;
+    if (!c.prim_known) c.bad = 1;
+    if (!(c.writes & LM_W_COLOR)) c.reads |= LM_R_COLOR;
+    if (!(c.writes & LM_W_UV)) c.reads |= LM_R_UV;
+    if (partial && !(c.writes & LM_W_VXYZ)) c.reads |= LM_R_VXYZ;
+    c.writes |= LM_W_VXYZ;
+}
+
+void lm_note(uint8_t cmd, const uint32_t *p) {
+    LmCap &c = g_lm;
+    if (cmd == 0x14) {   // MTX_RESTORE: a live command, in position or position-vector mode
+        if ((g.mode != 1 && g.mode != 2) || c.nlive == LM_MAX_LIVE) {
+            if (!c.bad) c.bad_cmd = cmd;
+            c.bad = 1;
+            return;
+        }
+        c.slots |= 1u << (p[0] & 31);
+        c.live[c.nlive++] = LmLive{p[0], (uint32_t)g_rec.v.size(), (uint32_t)g_rec.idx.size()};
+        return;
+    }
+    int s = 0;
+    while (s < LM_NCMD && kLmCmds[s] != cmd) ++s;
+    if (s == LM_NCMD) {
+        if (!c.bad) c.bad_cmd = cmd;
+        c.bad = 1;
+        return;
+    }
+    ++c.cmd_n[s];
+    switch (cmd) {
+        case 0x20: c.writes |= LM_W_COLOR; break;
+        case 0x21:
+            c.reads |= LM_R_LIGHT;
+            c.writes |= LM_W_COLOR | LM_W_NRM;
+            if (((g_teximage >> 30) & 3) == 2) c.writes |= LM_W_UV;
+            break;
+        case 0x22: c.reads |= LM_R_TEXC; c.writes |= LM_W_UV | LM_W_RAW; break;
+        case 0x23: case 0x24: lm_vertex(false); break;
+        case 0x25: case 0x26: case 0x27: case 0x28: lm_vertex(true); break;
+        case 0x40: c.prim_known = 1; c.writes |= LM_W_PRIM | LM_W_PARITY; break;
+        case 0x41: c.prim_known = 1; c.writes |= LM_W_PRIM; break;
+        default: break;
+    }
+}
+
 void exec(uint8_t cmd, const uint32_t *p, int np) {
     (void)np;
     if (g_ip_rec) ip_push(IPK_CMD, cmd, np, p);
+    if (g_lm.on) lm_note(cmd, p);
     if ((unsigned)(cmd - 0x16) <= 6u && g_rec.on) rec_cmd(cmd);
     if (!g_ip_replaying) {
         ++g_cmd_n[cmd];
@@ -2933,6 +3023,7 @@ int g_port_have = 0;
 void gx_stream_note(uint32_t w);
 int g_stream_hash_on = 1;   // gx_stream_hash_enable
 void gx_write_fifo(uint32_t word) {
+    if (g_lm.on) lm_cap_abort();
     ++g_fifo_n;
     if (g_stream_hash_on) gx_stream_note(word);
     feed(word);
@@ -3353,6 +3444,465 @@ void gx_pltt_base(uint32_t v) {
 static uint32_t g_stream_hash = 2166136261u;
 void gx_stream_note(uint32_t w) { g_stream_hash = (g_stream_hash ^ w) * 16777619u; }
 
+namespace {
+
+void fifo_run(const uint32_t *src, int n);
+
+/* THE LIST MEMO (gx_list_memo; the 3DS port, whose frames are lean records).
+   A course draws the same ~300 display lists every frame, and decoding them
+   (exec, vertex, the strip assembly) was a fifth of an Old 3DS's level frame
+   in Azahar. A list made only of geometry (LmCap) adds to the record what its
+   words and a little of the entry state decide: its vertices (all on one
+   matrix id, the live one or one made at its first vertex), its triangles in
+   order, the strip it leaves, and the state fields it writes. So the first
+   time a list runs it runs the ordinary way and that is kept; the next time
+   it comes with the same words and the same entry state its key covers
+   (only what it reads before writing: the colour, the texels, the last
+   vertex, the lighting for a NORMAL, the texture matrix for texgen), the
+   kept result is put into the record instead, by the record's own steps for
+   what the live state still decides (the matrix id, the triangles' runs).
+   Mode 2 runs both and compares (SM64DS_LIST_MEMO_VERIFY's [lmemo] lines). */
+int g_lm_mode;   // 0 off, 1 on, 2 verify
+uint32_t g_lm_lists, g_lm_hits, g_lm_words_hit, g_lm_bad_verify;
+// why lists were not replayed, since the last report (gx_list_memo_report)
+enum { LMW_SHORT, LMW_NOREC, LMW_MIDCMD, LMW_OTHER, LMW_CMD, LMW_IDS, LMW_EARLY, LMW_KEY, LMW_SKIP,
+       LMW_KEEP, LMW_N };
+uint32_t g_lm_why[LMW_N], g_lm_why_cmd[256];
+// gx_list_begin's list (its first chunk is the next call from there), and a
+// replayed list's chunks still to come
+const uint32_t *g_lm_pend, *g_lm_skip_lo, *g_lm_skip_hi;
+int g_lm_pend_n;
+
+struct LmEntry {
+    uint32_t n = 0;
+    uint8_t ok = 0, tries = 0;
+    uint8_t misses = 0, skip = 0;     // key misses in a row (a lit list that moves), and the backoff
+    uint32_t reads = 0, writes = 0;
+    std::vector<uint32_t> words;
+    std::vector<RecVtx> v;            // the vertices (their id is the live one's at replay)
+    std::vector<uint16_t> tri;        // corners, from the list's first vertex
+    // segment k: MTX_RESTORE live[k - 1] (none for the first), then vertices
+    // seg_v[k] .. seg_v[k + 1] and triangles seg_t[k] .. seg_t[k + 1] (corners)
+    std::vector<uint32_t> live, seg_v, seg_t;
+    uint32_t slots = 0;
+    std::vector<uint32_t> key;        // lm_key's words for the entry state it was kept under
+    std::vector<uint32_t> strip;      // Rec::strip after it, the same way
+    uint32_t strip_base = 0;          // Rec::strip_base after it, the same way
+    uint32_t cmd_n[LM_NCMD] = {};
+    // the fields it writes (LM_W_*), as it leaves them
+    int16_t vx = 0, vy = 0, vz = 0;
+    int prim = -1, normal_live = 0, parity = 0;
+    uint32_t color = 0;
+    float u = 0, v_ = 0, raw_u = 0, raw_v = 0, nrm[3] = {};
+};
+std::unordered_map<const uint32_t *, LmEntry> g_lm_map;
+
+inline void lm_put_words(std::vector<uint32_t> &k, const void *p, size_t bytes) {
+    const uint32_t *w = static_cast<const uint32_t *>(p);
+    k.insert(k.end(), w, w + bytes / 4);
+}
+
+/* The entry state a list of `reads` (restoring `slots`) depends on, as its
+   words: compared whole, not hashed (a word-wise hash let two lightings that
+   differ only in sign bits, which cancel in pairs, look the same). */
+void lm_key(uint32_t reads, uint32_t slots, std::vector<uint32_t> &k) {
+    k.clear();
+    if (reads & LM_R_COLOR) lm_put_words(k, &g.color, 4);
+    if (reads & LM_R_UV) { lm_put_words(k, &g.u, 4); lm_put_words(k, &g.v, 4); }
+    if (reads & LM_R_VXYZ) {
+        const int32_t xyz[3] = {g.vx, g.vy, g.vz};
+        lm_put_words(k, xyz, sizeof xyz);
+    }
+    const uint32_t texgen = (g_teximage >> 30) & 3;
+    if (reads & (LM_R_TEXC | LM_R_LIGHT)) {
+        lm_put_words(k, &texgen, 4);
+        if ((texgen == 1 && (reads & LM_R_TEXC)) || (texgen == 2 && (reads & LM_R_LIGHT)))
+            lm_put_words(k, g.tex.m, sizeof g.tex.m);
+    }
+    if (slots) lm_put_words(k, &g.mode, sizeof g.mode);
+    if (reads & LM_R_LIGHT) {
+        if (texgen == 2) { lm_put_words(k, &g.raw_u, 4); lm_put_words(k, &g.raw_v, 4); }
+        lm_put_words(k, g.vec.m, sizeof(float) * 12);
+        for (uint32_t m = slots; m; m &= m - 1)
+            lm_put_words(k, g.vec_stack[__builtin_ctz(m)].m, sizeof(float) * 12);
+        lm_put_words(k, g.emission, sizeof g.emission);
+        lm_put_words(k, g.diffuse, sizeof g.diffuse);
+        lm_put_words(k, g.ambient, sizeof g.ambient);
+        const uint32_t lmask = (g.poly_attr & 0xFu) | g.light_mask;
+        lm_put_words(k, &lmask, 4);
+        for (int i = 0; i < 4; ++i)
+            if ((lmask >> i) & 1) lm_put_words(k, &g.lights[i], sizeof g.lights[i]);
+    }
+}
+
+/* A list being kept: it may come in chunks (func_0205a290 sends 0x1D8 bytes
+   at a time, the next chunk when the FIFO asks), so the keeping opens at its
+   first and closes after its last; anything else reaching the engine between
+   them ends it unkept. */
+struct LmOpen {
+    LmEntry *e;                       // nullptr: none open
+    const uint32_t *next, *end;       // where the next chunk starts; the list's end
+    uint32_t vbase, ibase;
+    size_t mtx_n;
+    // the entry state a key can hold (what the list reads is known only
+    // after it ran)
+    uint32_t color;
+    float u, v, raw_u, raw_v;
+    int16_t vx, vy, vz;
+    Mat vec;
+};
+LmOpen g_lm_open;
+
+void lm_cap_begin(LmEntry &e, const uint32_t *src, int n) {
+    const Rec &R = g_rec;
+    LmOpen &o = g_lm_open;
+    o.e = &e;
+    o.next = src;
+    o.end = src + n;
+    o.vbase = (uint32_t)R.v.size();
+    o.ibase = (uint32_t)R.idx.size();
+    o.mtx_n = R.mtx.size();
+    o.color = g.color;
+    o.u = g.u; o.v = g.v; o.raw_u = g.raw_u; o.raw_v = g.raw_v;
+    o.vx = g.vx; o.vy = g.vy; o.vz = g.vz;
+    o.vec = g.vec;
+    g_lm = LmCap{};
+    g_lm.bad_cmd = -1;
+    g_lm.on = 1;
+    e.n = (uint32_t)n;
+    e.words.assign(src, src + n);
+    e.ok = 0;
+    ++e.tries;
+}
+
+void lm_cap_abort() {
+    g_lm.on = 0;
+    g_lm_open.e = nullptr;
+}
+
+void lm_frame_reset() {
+    lm_cap_abort();
+    g_lm_pend = g_lm_skip_lo = g_lm_skip_hi = nullptr;
+}
+
+// The list ran whole: keep it if it is one the memo replays.
+void lm_cap_end() {
+    LmOpen &o = g_lm_open;
+    LmEntry &e = *o.e;
+    g_lm.on = 0;
+    o.e = nullptr;
+    Rec &R = g_rec;
+    const uint32_t vbase = o.vbase, ibase = o.ibase;
+    if (g_lm.bad || !R.on || g_queued || g_have) {
+        ++g_lm_why[g_lm.bad ? (g_lm.prim_known ? LMW_CMD : LMW_EARLY) : LMW_IDS];
+        if (g_lm.bad_cmd >= 0) ++g_lm_why_cmd[g_lm.bad_cmd];
+        return;
+    }
+    // the segments; a segment's vertices all on one id, the live one at its
+    // first vertex or one made there (so a replay makes it the same way)
+    e.live.resize(g_lm.nlive);
+    e.seg_v.resize(g_lm.nlive + 2);
+    e.seg_t.resize(g_lm.nlive + 2);
+    e.seg_v[0] = 0;
+    e.seg_t[0] = 0;
+    for (uint32_t k = 0; k < g_lm.nlive; ++k) {
+        e.live[k] = g_lm.live[k].param;
+        e.seg_v[k + 1] = g_lm.live[k].v - vbase;
+        e.seg_t[k + 1] = g_lm.live[k].t - ibase;
+    }
+    e.seg_v[g_lm.nlive + 1] = (uint32_t)R.v.size() - vbase;
+    e.seg_t[g_lm.nlive + 1] = (uint32_t)R.idx.size() - ibase;
+    e.slots = g_lm.slots;
+    size_t ids = o.mtx_n;
+    for (uint32_t k = 0; k + 1 < e.seg_v.size(); ++k) {
+        const uint32_t v0 = vbase + e.seg_v[k], v1 = vbase + e.seg_v[k + 1];
+        if (v0 == v1) continue;
+        const uint32_t id = rec_id(R.v[v0]);
+        if (id == ids) ++ids;   // made at this segment's first vertex
+        else if (!ids || id != ids - 1) { ++g_lm_why[LMW_IDS]; return; }   // not the live one
+        for (uint32_t x = v0; x < v1; ++x)
+            if (rec_id(R.v[x]) != id) { ++g_lm_why[LMW_IDS]; return; }
+    }
+    if (ids != R.mtx.size()) { ++g_lm_why[LMW_IDS]; return; }
+    for (uint32_t k = ibase; k < R.idx.size(); ++k)
+        if (R.idx[k] < vbase) return;
+    for (uint32_t x : R.strip)
+        if (x < vbase) return;
+    e.v.assign(R.v.begin() + vbase, R.v.end());
+    e.tri.resize(R.idx.size() - ibase);
+    for (size_t k = 0; k < e.tri.size(); ++k) e.tri[k] = (uint16_t)(R.idx[ibase + k] - vbase);
+    e.strip.resize(R.strip.size());
+    for (size_t k = 0; k < e.strip.size(); ++k) e.strip[k] = R.strip[k] - vbase;
+    e.strip_base = R.strip_base - vbase;
+    std::memcpy(e.cmd_n, g_lm.cmd_n, sizeof e.cmd_n);
+    e.reads = g_lm.reads;
+    e.writes = g_lm.writes;
+    e.vx = g.vx; e.vy = g.vy; e.vz = g.vz;
+    e.prim = g.prim;
+    e.normal_live = g.normal_live;
+    e.parity = g.strip_parity;
+    e.color = g.color;
+    e.u = g.u; e.v_ = g.v; e.raw_u = g.raw_u; e.raw_v = g.raw_v;
+    std::memcpy(e.nrm, g.nrm, sizeof e.nrm);
+    // the key, from the entry state put back for the moment
+    g.color = o.color; g.u = o.u; g.v = o.v; g.raw_u = o.raw_u; g.raw_v = o.raw_v;
+    g.vx = o.vx; g.vy = o.vy; g.vz = o.vz;
+    const Mat vec_x = g.vec;   // its MTX_RESTOREs moved it
+    g.vec = o.vec;
+    lm_key(e.reads, e.slots, e.key);
+    g.color = e.color; g.u = e.u; g.v = e.v_; g.raw_u = e.raw_u; g.raw_v = e.raw_v;
+    g.vx = e.vx; g.vy = e.vy; g.vz = e.vz;
+    g.vec = vec_x;
+    e.ok = 1;
+}
