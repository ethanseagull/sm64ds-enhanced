+// A new matrix id: the live matrices, viewport and keys (false: the record
+// stopped, too many ids).
+inline bool rec_new_id() {
+    Rec &R = g_rec;
+    /* the frame's first menu-wide question may set the viewport, and in
+       the list's own flow it is asked inside this vertex's project() */
+    (void)menu_wide();
+    if (R.mtx.size() >= 0x7FFF) { rec_stop(REC_IDS); return false; }
+    R.mtx.emplace_back();   // in place: the skinned title face makes ~490 a frame
+    RecMtx &m = R.mtx.back();
+    m.pos = g.pos;
+    m.proj = g.proj;
+    m.vp[0] = g.vp_x; m.vp[1] = g.vp_y; m.vp[2] = g.vp_w; m.vp[3] = g.vp_h;
+    m.sprite = g_menu_sprite;
+    m.src = g_ip_dma_src;
+    m.shape = R.shape;
+    m.vhash = 2166136261u;
+    m.nv = 0;
+    m.first = (uint32_t)R.v.size();
+    m.cs[0] = m.cs[1] = m.cs[2] = 0.0f;
+    m.persp = (m.proj.m[3] != 0.0f || m.proj.m[7] != 0.0f || m.proj.m[11] != 0.0f) ? 1 : 0;
+    return true;
+}
+
+// rec_vertex's per-id statistics (gx_record_id_stats)
+inline void rec_id_stat(RecMtx &m, int16_t x, int16_t y, int16_t z) {
+    uint32_t h = m.vhash;
+    h = (h ^ (uint16_t)x) * 16777619u;
+    h = (h ^ (uint16_t)y) * 16777619u;
+    h = (h ^ (uint16_t)z) * 16777619u;
+    m.vhash = h;
+    m.cs[0] += x;
+    m.cs[1] += y;
+    m.cs[2] += z;
+    ++m.nv;
+}
+
