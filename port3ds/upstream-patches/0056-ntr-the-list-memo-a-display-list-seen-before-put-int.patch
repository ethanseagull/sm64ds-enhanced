+// gx_write_fifo_n's way in, at a list's first chunk (`n` the WHOLE list's
+// words): 1 when the list was put into the record here (its chunks are not to
+// run), 0 when the chunk is to run (a keeping may have opened).
+int lm_start(const uint32_t *src, int n) {
+    const Rec &R = g_rec;
+    if (n < 16) { ++g_lm_why[LMW_SHORT]; return 0; }
+    if (!R.on || !R.lean) { ++g_lm_why[LMW_NOREC]; return 0; }
+    if (g_queued || g_have) { ++g_lm_why[LMW_MIDCMD]; return 0; }
+    if (g_ip_rec || g_ip_replaying || g_ip_armed || smooth_lvl() > 0 || mat_log()) {
+        ++g_lm_why[LMW_OTHER];
+        return 0;
+    }
+    ++g_lm_lists;
+    if (g_lm_map.size() > 4096) g_lm_map.clear();
+    LmEntry &e = g_lm_map[src];
+    const bool same = e.n == (uint32_t)n && !std::memcmp(e.words.data(), src, (size_t)n * 4);
+    if (same && e.ok) {
+        static std::vector<uint32_t> key;
+        lm_key(e.reads, e.slots, key);
+        if (key == e.key) {
+            e.misses = 0;
+            ++g_lm_hits;
+            g_lm_words_hit += (uint32_t)n;
+            if (g_lm_mode == 2) lm_verify(e, src, n);
+            else lm_replay(e);
+            return 1;
+        }
+        // a key that keeps changing (a lit model turning) is kept again only
+        // now and then: keeping costs more than the ordinary run
+        ++g_lm_why[LMW_KEY];
+        if (e.misses >= 3 && (++e.skip & 15)) return 0;
+        if (e.misses < 255) ++e.misses;
+    }
+    if (same && !e.ok && e.tries >= 2) { ++g_lm_why[LMW_SKIP]; return 0; }   // not a list it replays
+    ++g_lm_why[LMW_KEEP];
+    if (!same) e.tries = 0;
+    lm_cap_begin(e, src, n);
+    return 0;
+}
