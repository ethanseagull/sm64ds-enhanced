+// The kept list into the record (lm_capture's notes on what is live).
+void lm_replay(const LmEntry &e) {
+    Rec &R = g_rec;
+    const uint32_t vbase = (uint32_t)R.v.size();
+    R.v.reserve(vbase + e.v.size());
+    for (size_t k = 0; k + 1 < e.seg_v.size(); ++k) {
+        if (k) exec(0x14, &e.live[k - 1], 1);   // MTX_RESTORE, with this frame's matrices
+        const uint32_t v0 = e.seg_v[k], v1 = e.seg_v[k + 1];
+        if (v0 != v1) {
+            // vertex(): the segment's first vertex's matrix id
+            const bool new_id = g_s5_mtx_dirty;
+            if (new_id) { ++g_s5_frame[S5_MTX]; g_s5_mtx_dirty = false; }
+            g_s5_frame[S5_VERTS] += v1 - v0;
+            if ((new_id || R.mtx.empty()) && !rec_new_id()) goto state;   // the record stopped
+            R.geom = 1;
+            const uint16_t id =
+                (uint16_t)((R.mtx.size() - 1) | (R.mtx.back().persp ? 0x8000u : 0u));
+            const size_t at = R.v.size();
+            R.v.resize(at + (v1 - v0));
+            RecVtx *out = R.v.data() + at;
+            for (uint32_t x = v0; x < v1; ++x) {
+                *out = e.v[x];
+                out->id = id;
+                ++out;
+            }
+            if (g_rec_id_stats) {
+                RecMtx &m = R.mtx.back();
+                for (uint32_t x = v0; x < v1; ++x) rec_id_stat(m, e.v[x].x, e.v[x].y, e.v[x].z);
+            }
+        }
+        for (uint32_t t = e.seg_t[k]; t < e.seg_t[k + 1]; t += 3)
+            rec_lean_tri(vbase + e.tri[t], vbase + e.tri[t + 1], vbase + e.tri[t + 2]);
+    }
+    if (!e.v.empty()) R.strip_base = vbase + e.strip_base;
+    if (e.writes & (LM_W_PRIM | LM_W_VXYZ)) {
+        R.strip.resize(e.strip.size());
+        for (size_t k = 0; k < e.strip.size(); ++k) R.strip[k] = vbase + e.strip[k];
+    }
+state:
+    if (e.writes & LM_W_VXYZ) { g.vx = e.vx; g.vy = e.vy; g.vz = e.vz; }
+    if (e.writes & LM_W_PRIM) {
+        g.prim = e.prim;
+        g.strip.clear();
+        g.strip_raw.clear();
+    }
+    if (e.writes & LM_W_PARITY) g.strip_parity = e.parity;
+    if (e.writes & (LM_W_COLOR | LM_W_NRM)) { g.color = e.color; g.normal_live = e.normal_live; }
+    if (e.writes & LM_W_NRM) std::memcpy(g.nrm, e.nrm, sizeof e.nrm);
+    if (e.writes & LM_W_UV) { g.u = e.u; g.v = e.v_; }
+    if (e.writes & LM_W_RAW) { g.raw_u = e.raw_u; g.raw_v = e.raw_v; }
+    for (int s = 0; s < LM_NCMD; ++s) g_cmd_n[kLmCmds[s]] += e.cmd_n[s];
+}
+
+// Mode 2: everything the two ways may touch, taken and put back.
+struct LmSnap {
+    size_t nv, ni, nr, nm;
+    RecRun last_run;
+    RecMtx last_mtx;
+    std::vector<uint32_t> strip;
+    uint32_t strip_base;
+    int geom, on, bad;
+    int16_t vx, vy, vz;
+    int prim, normal_live, parity;
+    size_t gstrip, gstrip_raw;
+    uint32_t color;
+    float u, v, raw_u, raw_v, nrm[3];
+    unsigned s5[S5_N];
+    bool mtx_dirty, state_dirty, ortho;
+    uint32_t cmd_n[256];
+    Mat pos, vec;                 // a replay's MTX_RESTOREs set them
+    unsigned restore_mode[4];
+};
+void lm_take(LmSnap &s) {
+    Rec &R = g_rec;
+    s.pos = g.pos; s.vec = g.vec;
+    std::memcpy(s.restore_mode, g_mtx_restore_mode, sizeof s.restore_mode);
+    s.nv = R.v.size(); s.ni = R.idx.size(); s.nr = R.runs.size(); s.nm = R.mtx.size();
+    if (s.nr) s.last_run = R.runs.back();
+    if (s.nm) s.last_mtx = R.mtx.back();
+    s.strip = R.strip;
+    s.strip_base = R.strip_base;
+    s.geom = R.geom; s.on = R.on; s.bad = R.bad;
+    s.vx = g.vx; s.vy = g.vy; s.vz = g.vz;
+    s.prim = g.prim; s.normal_live = g.normal_live; s.parity = g.strip_parity;
+    s.gstrip = g.strip.size(); s.gstrip_raw = g.strip_raw.size();
+    s.color = g.color;
+    s.u = g.u; s.v = g.v; s.raw_u = g.raw_u; s.raw_v = g.raw_v;
+    std::memcpy(s.nrm, g.nrm, sizeof s.nrm);
+    std::memcpy(s.s5, g_s5_frame, sizeof s.s5);
+    s.mtx_dirty = g_s5_mtx_dirty; s.state_dirty = g_s5_state_dirty; s.ortho = g_frame_ortho;
+    std::memcpy(s.cmd_n, g_cmd_n, sizeof s.cmd_n);
+}
+void lm_put(const LmSnap &s) {
+    Rec &R = g_rec;
+    g.pos = s.pos; g.vec = s.vec;
+    std::memcpy(g_mtx_restore_mode, s.restore_mode, sizeof s.restore_mode);
+    R.v.resize(s.nv); R.idx.resize(s.ni); R.runs.resize(s.nr); R.mtx.resize(s.nm);
+    if (s.nr) R.runs.back() = s.last_run;
+    if (s.nm) R.mtx.back() = s.last_mtx;
+    R.strip = s.strip;
+    R.strip_base = s.strip_base;
+    R.geom = s.geom; R.on = s.on; R.bad = s.bad;
+    g.vx = s.vx; g.vy = s.vy; g.vz = s.vz;
+    g.prim = s.prim; g.normal_live = s.normal_live; g.strip_parity = s.parity;
+    g.color = s.color;
+    g.u = s.u; g.v = s.v; g.raw_u = s.raw_u; g.raw_v = s.raw_v;
+    std::memcpy(g.nrm, s.nrm, sizeof s.nrm);
+    std::memcpy(g_s5_frame, s.s5, sizeof s.s5);
+    g_s5_mtx_dirty = s.mtx_dirty; g_s5_state_dirty = s.state_dirty; g_frame_ortho = s.ortho;
+    std::memcpy(g_cmd_n, s.cmd_n, sizeof s.cmd_n);
+}
+// What a way left past `from` (the record's new rows and the live fields).
+struct LmOut {
+    LmSnap s;
+    std::vector<RecVtx> v;
+    std::vector<uint16_t> idx;
+    std::vector<RecRun> runs;
+    std::vector<RecMtx> mtx;
+};
+void lm_out(LmOut &o, const LmSnap &from) {
+    Rec &R = g_rec;
+    lm_take(o.s);
+    o.v.assign(R.v.begin() + from.nv, R.v.end());
+    o.idx.assign(R.idx.begin() + from.ni, R.idx.end());
+    o.runs.assign(R.runs.begin() + (from.nr ? from.nr - 1 : 0), R.runs.end());
+    o.mtx.assign(R.mtx.begin() + (from.nm ? from.nm - 1 : 0), R.mtx.end());
+}
+template <class T> bool lm_same(const std::vector<T> &a, const std::vector<T> &b) {
+    return a.size() == b.size() && (a.empty() || !std::memcmp(a.data(), b.data(), a.size() * sizeof(T)));
+}
+void lm_verify(const LmEntry &e, const uint32_t *src, int n) {
+    static LmSnap pre;
+    static LmOut a, b;
+    lm_take(pre);
+    lm_replay(e);
+    lm_out(a, pre);
+    lm_put(pre);
+    fifo_run(src, n);
+    lm_out(b, pre);
+    const char *what = nullptr;
+    if (!lm_same(a.v, b.v)) what = "vertices";
+    else if (!lm_same(a.idx, b.idx)) what = "triangles";
+    else if (!lm_same(a.runs, b.runs)) what = "runs";
+    else if (!lm_same(a.mtx, b.mtx)) what = "matrix ids";
+    else if (a.s.strip != b.s.strip || a.s.strip_base != b.s.strip_base || a.s.geom != b.s.geom ||
+             a.s.on != b.s.on)
+        what = "strip";
+    else if (a.s.vx != b.s.vx || a.s.vy != b.s.vy || a.s.vz != b.s.vz || a.s.prim != b.s.prim ||
+             a.s.normal_live != b.s.normal_live || a.s.parity != b.s.parity ||
+             a.s.gstrip != b.s.gstrip || a.s.gstrip_raw != b.s.gstrip_raw ||
+             a.s.color != b.s.color || std::memcmp(&a.s.u, &b.s.u, sizeof(float) * 7))
+        what = "state";
+    else if (std::memcmp(a.s.s5, b.s.s5, sizeof a.s.s5) || a.s.mtx_dirty != b.s.mtx_dirty ||
+             a.s.state_dirty != b.s.state_dirty || a.s.ortho != b.s.ortho)
+        what = "counters";
+    else if (std::memcmp(a.s.cmd_n, b.s.cmd_n, sizeof a.s.cmd_n) ||
+             std::memcmp(a.s.restore_mode, b.s.restore_mode, sizeof a.s.restore_mode))
+        what = "census";
+    else if (std::memcmp(&a.s.pos, &b.s.pos, sizeof(Mat)) || std::memcmp(&a.s.vec, &b.s.vec, sizeof(Mat)))
+        what = "matrices";
+    if (what && g_lm_bad_verify++ < 20) {
+        std::printf("[lmemo] MISMATCH (%s): list %p, %d words, %u vertices; reads %x writes %x "
+                    "slots %x live %u; words", what, static_cast<const void *>(src), n,
+                    (unsigned)e.v.size(), (unsigned)e.reads, (unsigned)e.writes,
+                    (unsigned)e.slots, (unsigned)e.live.size());
+        for (int k = 0; k < n && k < 12; ++k) std::printf(" %08x", (unsigned)src[k]);
+        std::printf("\n");
+        for (size_t k = 0; k < a.v.size() && k < b.v.size(); ++k)
+            if (std::memcmp(&a.v[k], &b.v[k], sizeof a.v[k])) {
+                const RecVtx &x = a.v[k], &y = b.v[k];
+                std::printf("[lmemo]   vertex %u of %u/%u: replay %d,%d,%d id %04x c %08x uv %g,%g;"
+                            " decode %d,%d,%d id %04x c %08x uv %g,%g\n",
+                            (unsigned)k, (unsigned)a.v.size(), (unsigned)b.v.size(), x.x, x.y,
+                            x.z, x.id, (unsigned)x.color, x.u, x.v, y.x, y.y, y.z, y.id,
+                            (unsigned)y.color, y.u, y.v);
+                break;
+            }
+    }
+}
