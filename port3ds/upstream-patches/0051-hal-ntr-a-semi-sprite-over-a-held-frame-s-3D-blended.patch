diff --git a/port/ntr/include/ntr/gx.h b/port/ntr/include/ntr/gx.h
index f8eca96ce..2b5bb0699 100644
--- a/port/ntr/include/ntr/gx.h
+++ b/port/ntr/include/ntr/gx.h
@@ -607,6 +607,43 @@ void gx_clear_fill(Framebuffer &fb);
 #define GX_OV_NONE   0x00u
 #define GX_OV_FRONT  0xFFu
 #define GX_OV_BEHIND 0xFEu
+// A BLEND WITH THE 3D LAYER (a semi-transparent sprite over the 3D, BLDALPHA's
+// eva/evb), for a host whose card says it can draw one (gx_card_blend_ok):
+// alpha 1..0xEF. The colour is the sprite's share, premultiplied (top *
+// eva / 16), and the alpha byte is 255 - 16 * evb, so the 3D pixel's share is
+// what the present adds: c + dst * (1 - a / 255), clamped, the DS's blend in
+// 8 bits. Where the 3D drew nothing dst is the clear colour, as the
+// processor's blend reads it. gx_card_note_blend: such a word was written this
+// frame. Without the card's say-so the compositor settles instead, as before.
+inline bool gx_ov_is_blend(uint32_t w)
+{
+    const uint32_t a = w >> 24;
+    return a != 0 && a < GX_OV_BEHIND;
+}
+inline uint32_t gx_ov_blend_word(uint32_t top, int eva, int evb)
+{
+    auto share = [&](int sh) {
+        const int v = (int)((top >> sh) & 0xFFu) * eva / 16;
+        return (uint32_t)(v > 255 ? 255 : v) << sh;
+    };
+    int a = 255 - 16 * evb;
+    if (a < 1) a = 1;
+    return (uint32_t)a << 24 | share(16) | share(8) | share(0);
+}
+// The word over a picture's own pixel `base` (a settle's resolve).
+inline uint32_t gx_ov_blend_apply(uint32_t w, uint32_t base)
+{
+    const int k = 255 - (int)(w >> 24);
+    auto mix = [&](int sh) {
+        const int v = (int)((w >> sh) & 0xFFu) + ((int)((base >> sh) & 0xFFu) * k + 127) / 255;
+        return (uint32_t)(v > 255 ? 255 : v) << sh;
+    };
+    return 0xFF000000u | mix(16) | mix(8) | mix(0);
+}
+void gx_card_set_blend_ok(int ok);
+int gx_card_blend_ok();
+void gx_card_note_blend();
+int gx_card_blend_seen();
 void gx_card_present_allow(int allow);
 int gx_card_overlay_active();
 void gx_card_settle();
