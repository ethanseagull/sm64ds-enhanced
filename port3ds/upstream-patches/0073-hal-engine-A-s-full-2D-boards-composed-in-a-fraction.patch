 }  // namespace
 
+/* ---- ENGINE A'S TEXT BGs KEPT AS PICTURES (3DS lane) -----------------------
+ *
+ * A minigame's top screen is three or four whole text BGs, and the BG loop
+ * read every tile of each one every frame: 13-16 ms of a board's frame on the
+ * 3DS. Their maps and tiles hardly change from frame to frame (the scroll
+ * does), so each BG is kept as a picture of its whole map in palette indices,
+ * the 4bpp bank folded in (0 = transparent), as ntr/ppu_sub.cpp's scan cache
+ * keeps engine B's. Its inputs are compared with saved copies each frame (the
+ * map, and the tile data up to the highest tile the map names): a changed map
+ * entry or tile redraws only its own tiles. A BG that redrew a quarter of its
+ * map three frames in a row is read tile by tile, as before, until it settles. The cells are the BG
+ * loop's own (SM64DS_TWOD_VERIFY=1 compares them with the reference loop's);
+ * SM64DS_BG_PLANE_OFF=1 reads every tile every frame. */
+namespace {
+struct APlane {
+    uint32_t screen = 0, chars = 0;
+    bool bpp8 = false;
+    int tw = 0, th = 0;
+    std::vector<uint8_t> map, chr;   // the inputs as they were last frame
+    std::vector<uint8_t> ix;         // (tw * 8) x (th * 8) indices
+    bool valid = false;              // ix is a picture of map and chr
+    int busy = 0;                    // frames in a row that redrew much of it
+    bool direct = false;             // read directly until the inputs settle
+};
+APlane g_aplane[4];
+
+/* one tile of the picture, from the map entry at (tx, ty) */
+void aplane_tile(APlane &p, const BgConfig &c, int tx, int ty)
+{
+    const uint16_t se = rd16(screen_entry_addr(c, tx, ty));
+    const uint32_t tile = se & 0x3FF;
+    const unsigned bank = c.bpp8 ? 0u : ((se >> 12) & 0xFu) << 4;
+    const bool hflip = (se & 0x400) != 0;
+    const int pw = c.tiles_w * 8;
+    for (int fy = 0; fy < 8; ++fy) {
+        const int sy = (se & 0x800) ? 7 - fy : fy;
+        uint8_t *const dst = &p.ix[(size_t)(ty * 8 + fy) * pw + tx * 8];
+        if (c.bpp8) {
+            const uint8_t *src = reinterpret_cast<const uint8_t *>(c.chars + tile * 64 + sy * 8);
+            for (int fx = 0; fx < 8; ++fx) dst[fx] = src[hflip ? 7 - fx : fx];
+        } else {
+            const uint8_t *src = reinterpret_cast<const uint8_t *>(c.chars + tile * 32 + sy * 4);
+            for (int fx = 0; fx < 8; ++fx) {
+                const int sx = hflip ? 7 - fx : fx;
+                const unsigned v = (src[sx >> 1] >> ((sx & 1) * 4)) & 0xFu;
+                dst[fx] = v ? (uint8_t)(v | bank) : 0;
+            }
+        }
+    }
+}
+
+/* BG bg's picture for this frame, or null to read its tiles directly */
+const uint8_t *aplane_prepare(int bg, const BgConfig &c)
+{
+    static const bool off = std::getenv("SM64DS_BG_PLANE_OFF") != nullptr;
+    if (off) return nullptr;
+    APlane &p = g_aplane[bg];
+    const size_t map_len = (size_t)c.tiles_w * (size_t)c.tiles_h * 2u;
+    const uint8_t *const map = reinterpret_cast<const uint8_t *>(c.screen);
+    unsigned top = 0;
+    for (size_t i = 0; i < map_len; i += 2) {
+        const unsigned t = (map[i] | (unsigned)map[i + 1] << 8) & 0x3FFu;
+        if (t > top) top = t;
+    }
+    const size_t tsz = c.bpp8 ? 64u : 32u;
+    const size_t chr_len = (top + 1) * tsz;
+    const uint8_t *const chr = reinterpret_cast<const uint8_t *>(c.chars);
+    const bool same_bg = p.screen == c.screen && p.chars == c.chars && p.bpp8 == c.bpp8 &&
+                         p.tw == c.tiles_w && p.th == c.tiles_h && p.map.size() == map_len;
+    const bool same = same_bg && p.chr.size() == chr_len && !std::memcmp(p.map.data(), map, map_len) &&
+                      !std::memcmp(p.chr.data(), chr, chr_len);
+    const auto save = [&] {
+        p.screen = c.screen;
+        p.chars = c.chars;
+        p.bpp8 = c.bpp8;
+        p.tw = c.tiles_w;
+        p.th = c.tiles_h;
+        p.map.assign(map, map + map_len);
+        p.chr.assign(chr, chr + chr_len);
+    };
+    const auto redraw_all = [&] {
+        p.ix.resize((size_t)c.tiles_w * 8u * (size_t)c.tiles_h * 8u);
+        for (int ty = 0; ty < c.tiles_h; ++ty)
+            for (int tx = 0; tx < c.tiles_w; ++tx) aplane_tile(p, c, tx, ty);
+    };
+    if (same) {
+        p.busy = 0;
+        p.direct = false;
+        if (!p.valid) {   // settled: the picture again
+            redraw_all();
+            p.valid = true;
+        }
+        return p.ix.data();
+    }
+    if (p.direct) {   // changing every frame: read directly until it settles
+        save();
+        p.valid = false;
+        return nullptr;
+    }
+    const int tiles = c.tiles_w * c.tiles_h;
+    int n = 0;
+    if (p.valid && same_bg) {   // only the changed tiles
+        bool tile_changed[1024] = {};
+        const size_t old_len = p.chr.size();
+        for (unsigned t = 0; t <= top; ++t)
+            tile_changed[t] = (size_t)(t + 1) * tsz > old_len ||
+                              std::memcmp(p.chr.data() + t * tsz, chr + t * tsz, tsz) != 0;
+        for (int ty = 0; ty < c.tiles_h; ++ty)
+            for (int tx = 0; tx < c.tiles_w; ++tx) {
+                const size_t at = screen_entry_addr(c, tx, ty) - c.screen;
+                const unsigned now = map[at] | (unsigned)map[at + 1] << 8;
+                const unsigned was = p.map[at] | (unsigned)p.map[at + 1] << 8;
+                if (now != was || tile_changed[now & 0x3FFu]) {
+                    aplane_tile(p, c, tx, ty);
+                    ++n;
+                }
+            }
+    } else {
+        redraw_all();
+        n = tiles;
+    }
+    save();
+    p.valid = true;
+    /* three frames in a row that each redrew a quarter of the map or more:
+       the picture costs more than it saves */
+    p.busy = n * 4 > tiles ? p.busy + 1 : 0;
+    if (p.busy >= 3) p.direct = true;
+    return p.ix.data();
+}
+}  // namespace
