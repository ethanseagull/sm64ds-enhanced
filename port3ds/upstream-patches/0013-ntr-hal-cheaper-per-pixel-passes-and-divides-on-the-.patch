diff --git a/port/ntr/io.cpp b/port/ntr/io.cpp
index 2736e5e38..94e29826a 100644
--- a/port/ntr/io.cpp
+++ b/port/ntr/io.cpp
@@ -219,9 +219,19 @@ void run_divide() {
         rem = n;
         quot = (n < 0) ? 1 : -1;
         if (mode == 0) quot = (n < 0) ? 1 : -1;
+    } else if (n == static_cast<int32_t>(n) && d == static_cast<int32_t>(d) &&
+               !(n == INT32_MIN && d == -1)) {
+        /* Both fit in 32 bits (every 32/32 divide and most of the rest): a
+           32-bit divide, one of them. On a host without a divide instruction
+           (the 3DS's ARM11) the two 64-bit library divides this did were ~9%
+           of a Bob-omb Battlefield frame, and this runs on every write to the
+           unit's operands. Same quotient and remainder (C truncates both). */
+        const int32_t q32 = static_cast<int32_t>(n) / static_cast<int32_t>(d);
+        quot = q32;
+        rem = static_cast<int32_t>(n) - q32 * static_cast<int32_t>(d);
     } else {
         quot = n / d;
-        rem = n % d;
+        rem = n - quot * d;
     }
     raw_write(DIV_RESULT, static_cast<uint64_t>(quot), 8);
     raw_write(DIV_REM, static_cast<uint64_t>(rem), 8);
diff --git a/port/ntr/ppu_sub.cpp b/port/ntr/ppu_sub.cpp
