@@ -2356,27 +2427,42 @@ void bm_fill_default(uint32_t dispcnt, const Windows &w) {
     g_bm_shown3d = shown3d;
     g_bm_clear_opaque = clear_opaque;
     const unsigned out_mask = w.any ? w.out : 0x3F;
+    /* Per call, not per pixel (the 3DS port's ARM11 has no divide and the
