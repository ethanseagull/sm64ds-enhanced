diff --git a/port/hal/message_compositor.cpp b/port/hal/message_compositor.cpp
index 618214ee4..99cfec99f 100644
--- a/port/hal/message_compositor.cpp
+++ b/port/hal/message_compositor.cpp
@@ -724,6 +724,67 @@ inline unsigned window_mask(const Windows &w, int x, int y) {
     return w.out;
 }
 
+/* window_mask for every column of line y, filled as the few spans the windows
+   cut the line into instead of tested per pixel (a per-pixel call in three
+   per-pixel loops was ~15% of a Bob-omb Battlefield frame on the 3DS port,
+   whose ARM11 pays for every branch). The same precedence, built backwards:
+   WINOUT, then the OBJ window over it, then window 1, then window 0.
+   SM64DS_WINROW_VERIFY=1 compares it with window_mask on every call. */
+inline void win_h_span(const Windows &w, int i, int y, int x, int &a, int &b) {
+    /* the [a, b) run starting at x that win_h_inside answers alike for, and
+       whether it is inside is win_h_inside(w, i, a, y) */
+    int cuts[2];
+    int n = 0;
+    if (!w.rows_on) {
+        cuts[n++] = w.x1[i];
+        cuts[n++] = w.x2[i];
+    } else {
+        cuts[n++] = w.rx1[i][y];
+        cuts[n++] = w.rx2[i][y];
+    }
+    a = x;
+    b = 256;
+    for (int k = 0; k < n; ++k)
+        if (cuts[k] > x && cuts[k] < b) b = cuts[k];
+}
+
+bool winrow_verify_on() {
+    static int on = -1;
+    if (on < 0) {
+        const char *e = std::getenv("SM64DS_WINROW_VERIFY");
+        on = (e && *e && *e != '0') ? 1 : 0;
+    }
+    return on != 0;
+}
+
+inline void window_mask_row(const Windows &w, int y, unsigned char *row) {
+    if (!w.any) {
+        std::memset(row, 0x3F, 256);
+        return;
+    }
+    std::memset(row, w.out, 256);
+    if (w.obj_on)
+        for (int x = 0; x < 256; ++x)
+            if (g_objwin[y][x]) row[x] = (unsigned char)w.obj_in;
+    for (int i = 1; i >= 0; --i) {
+        if (!w.on[i] || y < w.y1[i] || y >= w.y2[i]) continue;
+        for (int x = 0; x < 256;) {
+            int a, b;
+            win_h_span(w, i, y, x, a, b);
+            if (win_h_inside(w, i, a, y))
+                std::memset(row + a, w.in[i], (size_t)(b - a));
+            x = b;
+        }
+    }
+    if (winrow_verify_on()) {
+        static unsigned long bad;
+        for (int x = 0; x < 256; ++x)
+            if (row[x] != (unsigned char)window_mask(w, x, y) && bad++ < 20)
+                std::fprintf(stderr, "[winrow] MISMATCH y %d x %d row %02x window_mask %02x\n",
+                             y, x, row[x], window_mask(w, x, y));
+    }
+}
+
