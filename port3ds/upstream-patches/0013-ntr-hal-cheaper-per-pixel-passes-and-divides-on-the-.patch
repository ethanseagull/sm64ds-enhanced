+        if (y < 192 && y != wrow_y) {
+            window_mask_row(w, y, wrow);
+            wrow_y = y;
+        }
         unsigned char *row = g_bm + (size_t)hy * ntr::SCREEN_W;
         for (int hx = 0; hx < ntr::active_w; ++hx) {
-            int x;
-            if (ntr::widescreen) {
-                const int d = hx - margin / 2;
-                x = d < 0 ? -1 : ds_col_of(d);
-            } else {
-                x = hx / sx;
-            }
-            const unsigned wm = (x >= 0 && x < 256 && y < 192)
-                                    ? window_mask(w, x, y) : out_mask;
+            const int x = s_dsx[hx];
+            const unsigned wm = (x >= 0 && x < 256 && y < 192) ? wrow[x] : out_mask;
             if (card) {
-                row[hx] = (unsigned char)(bm_verdict(0u, wm) |
-                                          (bm_verdict(5u, wm) << 1));
+                row[hx] = (unsigned char)(verdict(0u, wm) | (verdict(5u, wm) << 1));
                 continue;
             }
             const bool is3d = shown3d
                 && (clear_opaque || cover[(size_t)hy * ntr::SCREEN_W + hx]);
-            row[hx] = bm_verdict(is3d ? 0u : 5u, wm);
+            row[hx] = verdict(is3d ? 0u : 5u, wm);
         }
     }
     g_bm_live = true;
@@ -2534,6 +2620,7 @@ void bg_loop_ref(Cell (*a)[256], const BgConfig *bgs, const Windows &win,
                             s = blend_alpha(s, a[y][x].color, bl.eva, bl.evb);
                         a[y][x].color = s;
                         a[y][x].hit = true;
+                        g_a_clean[y] = 0;   /* conservative when a is the verify copy */
                         a[y][x].owner = (uint8_t)bg;
                         a[y][x].prio = (uint8_t)prio;
                     }
@@ -3312,8 +3399,11 @@ extern "C" void port_message_composite_engine_a(void *fbp)
     g_cz.mark(2);
     // Clear the hit buffer, then BGs by priority (lower priority drawn last so
