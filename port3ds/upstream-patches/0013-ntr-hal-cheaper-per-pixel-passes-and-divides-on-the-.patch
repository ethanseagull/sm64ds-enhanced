     const int rx = active_w / SUB_W, ry = active_h / SUB_H;
+    /* The source column of each x, once per call rather than a divide per
+       pixel (a library call on the 3DS's ARM11, which has no divide: ~5% of a
+       Bob-omb Battlefield frame in a profile). Same arithmetic, same answers. */
+    static int s_col[SCREEN_W];
+    const int ncol = active_w < SCREEN_W ? active_w : SCREEN_W;
+    for (int x = 0; x < ncol; ++x) {
+        const int sx = rx > 0 ? x / rx : (x * SUB_W) / active_w;
+        s_col[x] = sx < SUB_W ? sx : SUB_W - 1;
+    }
     for (int y = 0; y < active_h; ++y) {
         const int sy = ry > 0 ? y / ry : (y * SUB_H) / active_h;
         const uint32_t *src = sub.px[sy < SUB_H ? sy : SUB_H - 1];
         uint32_t *out = dst + (size_t)(b_y + y) * dst_w;
-        for (int x = 0; x < active_w; ++x) {
+        int x = 0;
+        for (; x < ncol; ++x)
+            out[x] = src[s_col[x]];
+        for (; x < active_w; ++x) {
             const int sx = rx > 0 ? x / rx : (x * SUB_W) / active_w;
             out[x] = src[sx < SUB_W ? sx : SUB_W - 1];
         }
