From 3189f8f3df615082a5b7160f29449cc4734f02c5 Mon Sep 17 00:00:00 2001
From: sm64ds-3ds <244728604+ethanseagull@users.noreply.github.com>
Date: Wed, 14 Oct 2026 08:39:07 -0700
Subject: [PATCH 07/13] hal: port_compa_zones_report, the compositor's zone
 clock on demand

SM64DS_COMPA_ZONES reports engine A's compose zones at exit; the 3DS host
closes its log before atexit runs, so it calls this from its own frame clock
instead (sums restarted after each report).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 port/hal/message_compositor.cpp | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/port/hal/message_compositor.cpp b/port/hal/message_compositor.cpp
index 5184d2898..618214ee4 100644
--- a/port/hal/message_compositor.cpp
+++ b/port/hal/message_compositor.cpp
@@ -160,6 +160,17 @@ void CaZones::report() {
     }
 }
 }
+/* The same report on demand, the sums then restarted: a host whose log is
+   closed before atexit runs (the 3DS) prints it from its own frame clock. */
+extern "C" void port_compa_zones_report(void)
+{
+    if (g_cz.on <= 0) return;
+    CaZones::report();
+    for (int l = 0; l < 2; ++l) {
+        g_cz.n[l] = 0;
+        for (double &a : g_cz.acc[l]) a = 0;
+    }
+}
 
 /* THE TOP ENGINE'S OBJ DISPLAY SHIFT, in DS rows, from hal/screen_gap.cpp.
  *
