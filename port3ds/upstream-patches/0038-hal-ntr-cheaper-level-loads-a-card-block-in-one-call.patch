diff --git a/port/ntr/card.cpp b/port/ntr/card.cpp
index bc1430588..648d27367 100644
--- a/port/ntr/card.cpp
+++ b/port/ntr/card.cpp
@@ -259,3 +259,28 @@ struct CardRegister {
 CardRegister g_card_register;
 
 }  // namespace
+
+// ONE B7h BLOCK IN ONE CALL (port3ds/game/card_fast.cpp wraps the ROM's page
+// reader, src/func_02060a64.c, with it). The driver stores ROMCTRL and then
+// polls it and reads the data port 128 times a 0x200-byte block: on the New
+// 3DS every one of those is an emulated register access, and they were the
+// CPU cost of a level change once the files themselves came from one pack.
+// This is the same block: ROMCTRL latched as the driver's store latches it,
+// the block fetched by start_block from the command bytes the driver wrote
+// (func_02060d98), its words copied to `out` (at most `max_words`, as the
+// driver's loop keeps at most 0x200), and the end state of the last data-port
+// read -- finish_block's ROMCTRL idle and the IF bit when AUXSPICNT asks.
+// The statistics count it as the polled path would. Returns the words.
+extern "C" unsigned port_card_block_direct(uint32_t romctrl, uint32_t *out, unsigned max_words)
+{
+    reg32(REG_ROMCTRL) = romctrl;
+    if (!(romctrl & ROMCTRL_BUSY)) return 0;
+    start_block(romctrl);
+    if (!g_blk.active) return 0;
+    const unsigned n = g_blk.words < max_words ? g_blk.words : max_words;
+    std::memcpy(out, g_blk.data, 4u * n);
+    g_st.words += g_blk.words;
+    g_blk.done = g_blk.words;
+    finish_block();
+    return n;
+}
