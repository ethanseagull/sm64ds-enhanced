+            /* LAYER BY LAYER along the line. A pixel's result depends only on
+               the layers before it at that same pixel, so this is the paint
+               order of the pixel-by-pixel loop. Each layer visits only the
+               columns its window bit shows, a tile at a time: the screen entry
+               and the tile's row of texels are read once, and a row with no
+               opaque texel is passed over whole (a dialogue box's BG3 is
+               mostly blank tiles). */
+            for (int k = 0; k < nbg; ++k) {
+                const int bg = bgorder[k];
+                const BgConfig &c = bgs[bg];
+                const unsigned bit = 1u << bg;
+                const int py = (y + c.vofs) & (c.tiles_h * 8 - 1);
+                const int xmask = c.tiles_w * 8 - 1;
+                const uint32_t bit4 = bit * 0x01010101u;
+                for (int x = 0; x < 256;) {
