+/* One 2D cell onto a frame held on the card: its host block takes the word
+   (colour and GX_OV_* verdict) and, with a mask live, the mask keeps its two
+   default bits under the cell's own (`bits`). */
+inline void blit_ov_cell(ntr::Framebuffer &fb, int hx0, int bw, int hy0, int hy1,
+                         uint32_t word, bool bm_on, unsigned char bits) {
+    for (int hy = hy0; hy < hy1; ++hy) {
+        uint32_t *const p = &fb.px[hy][hx0];
+        for (int dx = 0; dx < bw; ++dx) p[dx] = word;
+        if (!bm_on) continue;
+        unsigned char *const m = g_bm + (size_t)hy * ntr::SCREEN_W + hx0;
+        for (int dx = 0; dx < bw; ++dx) m[dx] = (unsigned char)((m[dx] & 3u) | bits);
+    }
+}
