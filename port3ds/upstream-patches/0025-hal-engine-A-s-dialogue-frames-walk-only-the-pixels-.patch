+/* g_a_quiet[y]: bit g set = columns 8g..8g+7 of row y are known to hold no
+   hit (all set by the clear). Every writer of a hit clears its group's bit
+   with g_a_clean (a_mark), so the clear and the final blit visit only the
+   groups that can hold one: a dialogue box's rows are mostly empty space. */
+uint32_t g_a_quiet[192];
+inline void a_mark(int y, int x) {
+    g_a_clean[y] = 0;
+    g_a_quiet[y] &= ~(1u << (x >> 3));
