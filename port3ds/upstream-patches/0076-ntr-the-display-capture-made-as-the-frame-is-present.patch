From 45f65483306c7f7ebc643287d20706c9169b20ea Mon Sep 17 00:00:00 2001
From: sm64ds-3ds <244728604+ethanseagull@users.noreply.github.com>
Date: Fri, 30 Oct 2026 13:44:29 -0700
Subject: [PATCH] ntr: the display capture made as the frame is presented, and
 engine B's bitmaps drawn straight

The card may take a capture and write it when it presents the frame (gx_card_capture_defer, behind a fence at the publish), and engine B draws a lone bitmap BG or bitmap sprites over one BG row by row.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 port/hal/gpu_raster.cpp   |   1 +
 port/ntr/gx.cpp           |  78 +++++++++++-
 port/ntr/include/ntr/gx.h |  18 +++
 port/ntr/ppu.cpp          |  43 +++++--
 port/ntr/ppu_sub.cpp      | 246 ++++++++++++++++++++++++++++++++++++++
 5 files changed, 372 insertions(+), 14 deletions(-)

diff --git a/port/hal/gpu_raster.cpp b/port/hal/gpu_raster.cpp
index b565639ec..81428dbeb 100644
--- a/port/hal/gpu_raster.cpp
+++ b/port/hal/gpu_raster.cpp
@@ -3388,6 +3388,7 @@ int card_settle(const ntr::GxGpuFrame *f)
 {
     if (f->settle == 3) return card_ret_readback(f);
     if (f->from_record) return 0;   /* draws triangles only: ask again with them */
+    if (f->defer) return 0;         /* captures as it settles, never later */
     if (!g_cp_held || !f->fb) return 0;
     /* TWODGPU1: this tick's 2D is in the overlay target, not in the framebuffer */
     if (g_tw_live && (const uint32_t *)f->fb == g_tw_fb)
diff --git a/port/ntr/gx.cpp b/port/ntr/gx.cpp
index 19988d936..9b4b819bf 100644
--- a/port/ntr/gx.cpp
+++ b/port/ntr/gx.cpp
@@ -5961,6 +5961,41 @@ int gx_card_blend_ok() { return g_cp_active && g_cp_blend_ok; }
 void gx_card_note_blend() { g_cp_blend = 1; }
 int gx_card_blend_seen() { return g_cp_active && g_cp_blend; }
 int gx_card_pre_needed() { return g_cp_active && g_cp_pre_needed; }
+/* THE CAPTURE, DEFERRED (ntr/gx.h): the card writes it as it presents the
+   frame, off this thread. Held here until the frame is presented, so a frame
+   that is settled after all (gx_card_settle_because) takes it back first and
+   is captured the old way while its 3D is still on the card. */
+namespace {
+struct CapDefer {
+    uint16_t *dst;
+    int x, y, w, h;
+} g_cap_defer;
+int g_cap_deferred;   // this frame's capture was taken by the card
+void (*g_cap_fence)();
+
+void cap_undefer() {
+    if (!g_cap_deferred) return;
+    g_cap_deferred = 0;
+    GxGpuFrame f;
+    std::memset(&f, 0, sizeof f);
+    f.settle = 2;
+    f.defer = -1;
+    g_gpu_opaque(&f);
+    const CapDefer &c = g_cap_defer;
+    const uint32_t *pic = gx_card_capture_picture();
+    if (!pic) return;   /* the card could not: the block keeps what it had */
+    for (int y = 0; y < c.h; ++y) {
+        const uint32_t *row = pic + (size_t)(c.y + y) * (size_t)SCREEN_W + c.x;
+        uint16_t *out = c.dst + (size_t)y * (size_t)c.w;
+        for (int x = 0; x < c.w; ++x) {
+            const uint32_t p = row[x];
+            out[x] = (uint16_t)(0x8000u | (((p >> 3) & 0x1Fu) << 10) |
+                                (((p >> 11) & 0x1Fu) << 5) | ((p >> 19) & 0x1Fu));
+        }
+    }
+}
+}  // namespace
+
 void gx_card_retire(const Framebuffer *fb)
 {
     /* the tick is composited: nothing of it is held for a later settle */
@@ -6003,8 +6038,10 @@ int gx_card_interp_clear(Framebuffer &fb)
 
 static void clear_fill_impl(Framebuffer &fb, bool wipe)
 {
-    /* a new frame: nothing from the last one is held any more */
+    /* a new frame: nothing from the last one is held any more (a capture the
+       card took went with the frame it presented) */
     g_cp_active = 0;
+    g_cap_deferred = 0;
     g_cp_pending = 0;
     g_cp_behind = 0;
     g_cp_blend = 0;
@@ -6141,6 +6178,8 @@ void gx_card_settle_because(const char *why)
         if (i == used && used < 16) { tab[used].why = why; tab[used].n = 0; ++used; }
         if (i < used) ++tab[i].n;
     }
+    /* a capture the card took for this frame is made now, from the card */
+    cap_undefer();
     /* classical from here on, whatever the card answers */
     g_cp_active = 0;
     raster_buffers();
@@ -6237,6 +6276,43 @@ const uint32_t *gx_card_capture_picture()
     return g_cp_scratch;
 }
 
+int gx_card_capture_defer(uint16_t *dst, int x, int y, int w, int h) {
+    if (!g_cp_active || !g_cp_fb || !g_gpu_opaque || g_cap_deferred) return 0;
+    if (!(g_rec.lean && g_rec.on && !g_rec.listed)) return 0;   /* the record draws it */
+    GxGpuOut out;
+    std::memset(&out, 0, sizeof out);
+    GxGpuFrame f;
+    std::memset(&f, 0, sizeof f);
+    f.settle = 2;
+    f.defer = 1;
+    f.cap_dst = dst;
+    f.cap_x = x;
+    f.cap_y = y;
+    f.cap_w = w;
+    f.cap_h = h;
+    f.outside_argb = kOldClear;
+    f.fb = &g_cp_fb->px[0][0];
+    f.stride = SCREEN_W;
+    f.cw = g_cp_geo.cw;
+    f.ch = g_cp_geo.ch;
+    f.px0 = g_cp_geo.px0;
+    f.py0 = g_cp_geo.py0;
+    f.pw = g_cp_geo.pw;
+    f.ph = g_cp_geo.ph;
+    f.aa_mode = g_aa_mode;
+    f.out = &out;
+    if (g_gpu_opaque(&f) != 1) return 0;
+    g_cap_defer = {dst, x, y, w, h};
+    g_cap_deferred = 1;
+    return 1;
+}
+
+void gx_card_capture_fence() {
+    if (g_cap_fence) g_cap_fence();
+}
+
+void gx_set_capture_fence(void (*fence)()) { g_cap_fence = fence; }
+
 namespace {
 
 /* Rec.601 luma, the channel weighting every edge filter of this family uses,
diff --git a/port/ntr/include/ntr/gx.h b/port/ntr/include/ntr/gx.h
index 4149930e7..35ecf21c8 100644
--- a/port/ntr/include/ntr/gx.h
+++ b/port/ntr/include/ntr/gx.h
@@ -534,9 +534,19 @@ struct GxGpuFrame {
     //         (gx_copy_record) instead, answering 1; any other answer and the
