 uint64_t memo_sum(uintptr_t lo, uintptr_t hi)
 {
     const uint32_t *p = reinterpret_cast<const uint32_t *>(lo);
     const size_t n = (hi - lo) >> 2;
-    uint32_t a = 2166136261u, b = 0x9E3779B9u ^ (uint32_t)n;
-    for (size_t i = 0; i < n; ++i) {
-        const uint32_t w = p[i];
-        a = (a ^ w) * 16777619u;
-        b = ((b << 5) | (b >> 27)) + w * 0x9E3779B1u;
+    uint32_t a0 = 2166136261u, a1 = 0x811C9DC5u ^ 0x5bd1e995u, b = 0x9E3779B9u ^ (uint32_t)n;
+    size_t i = 0;
+    for (; i + 1 < n; i += 2) {
+        const uint32_t w0 = p[i], w1 = p[i + 1];
+        a0 = (a0 ^ w0) * 16777619u;
+        a1 = (a1 ^ w1) * 16777619u;
+        b = ((b << 5) | (b >> 27)) + w0;
+        b = ((b << 5) | (b >> 27)) + w1;
     }
-    return (uint64_t)a << 32 | (b ^ (a >> 15));
+    if (i < n) {
+        a0 = (a0 ^ p[i]) * 16777619u;
+        b = ((b << 5) | (b >> 27)) + p[i];
+    }
+    return (uint64_t)(a0 ^ ((a1 << 16) | (a1 >> 16))) << 32 | (b ^ a1 ^ (a0 >> 15));
