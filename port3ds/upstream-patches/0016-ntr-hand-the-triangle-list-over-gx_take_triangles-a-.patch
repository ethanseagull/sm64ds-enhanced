From 50c52d6f61e6396468e5b4693cd2ae00adc3ca9a Mon Sep 17 00:00:00 2001
From: sm64ds-3ds <244728604+ethanseagull@users.noreply.github.com>
Date: Fri, 16 Oct 2026 21:08:02 -0700
Subject: [PATCH] ntr: hand the triangle list over (gx_take_triangles); a
 leaner geometry front end

gx_take_triangles swaps the frame's triangle list out to a backend that
draws a kept frame after the next frame's command stream has begun (the
3DS port presents on another core).

The front end, bit for bit the same output: the Hor+ factor, the
smoother's level and its in/out counters are answered once a frame
instead of at every vertex or triangle; a triangle with no vertex behind
the near plane is built in place on the polygon list instead of through
four intermediate copies of each vertex; param_count is a table in the
FIFO state machine. On the 3DS port (Azahar) the actor render walk is
~17% cheaper and the player's draw ~15%.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 port/ntr/gx.cpp           | 124 +++++++++++++++++++++++++++++++-------
 port/ntr/include/ntr/gx.h |   8 +++
 2 files changed, 109 insertions(+), 23 deletions(-)

diff --git a/port/ntr/gx.cpp b/port/ntr/gx.cpp
index 3072171d9..384dc7126 100644
--- a/port/ntr/gx.cpp
+++ b/port/ntr/gx.cpp
@@ -573,6 +573,37 @@ bool menu_wide() {
     return g.mw_on != 0;
 }
 
+/* THE PER-VERTEX QUESTIONS, ANSWERED ONCE A FRAME (the 3DS port, where this
+   front end is most of a frame's CPU). Each is the same expression it was,
+   evaluated once at the first use after gx_reset instead of at every vertex
+   or triangle: the Hor+ factor below (two out-of-line calls and a divide),
+   the smoother's level (an out-of-line call in smooth.cpp, read three times
+   a vertex), and the smoother's in/out triangle counters, which are summed
+   here and handed to smooth_count once a frame (gx_reset). None of them
+   changes inside a frame. */
+float g_widen;
+bool g_widen_ok;
+inline float hor_widen() {
+    if (!g_widen_ok) {
+        g_widen = (4.0f / 3.0f) * ((float)present_h() / (float)present_w());
+        g_widen_ok = true;
+    }
+    return g_widen;
+}
+int g_smooth_lvl = -1;
+inline int smooth_lvl() {
+    if (g_smooth_lvl < 0) g_smooth_lvl = smooth_level();
+    return g_smooth_lvl;
+}
+uint64_t g_smooth_in, g_smooth_out;
+void per_frame_answers_reset() {
+    if (g_smooth_in) smooth_count(SMOOTH_COUNT_IN, g_smooth_in);
+    if (g_smooth_out) smooth_count(SMOOTH_COUNT_OUT, g_smooth_out);
+    g_smooth_in = g_smooth_out = 0;
+    g_widen_ok = false;
+    g_smooth_lvl = -1;
+}
+
 /* VIEW SPACE -> CLIP SPACE, factored out of project() and out of nothing
    else. The model smoother (ntr/smooth.h) projects the vertices it invents
    through THIS function rather than through a copy of these six lines, so a
@@ -594,11 +625,8 @@ Vec4 view_to_clip(const Vec4 &view) {
         }
         return c;
     }
-    if (g.proj.m[3] != 0.0f || g.proj.m[7] != 0.0f || g.proj.m[11] != 0.0f) {
-        const float widen =
-            (4.0f / 3.0f) * ((float)present_h() / (float)present_w());
-        c.x *= widen;
-    }
+    if (g.proj.m[3] != 0.0f || g.proj.m[7] != 0.0f || g.proj.m[11] != 0.0f)
+        c.x *= hor_widen();
     return c;
 }
 
@@ -631,7 +659,7 @@ GxVertex project(int16_t x, int16_t y, int16_t z) {
        The multiply itself now lives in view_to_clip() just above, because the
        smoother has to apply the same one to the vertices it invents. */
 
-    if (stargeo_on()) {
+    if (g_stargeo.on && stargeo_on()) {
         StarGeo &G = g_stargeo;
         const float mx = x * FX12, my = y * FX12, mz = z * FX12;
         if (!G.n) {
@@ -859,8 +887,35 @@ void push_screen_tri(const GxVertex &a, const GxVertex &b, const GxVertex &c) {
     /* MDL: what actually reached the polygon list. Paired with
        SMOOTH_COUNT_IN in emit_tri, this is the submitted-versus-emitted row
        of the measurement table, and the two move together on every triangle
-       the smoother declined. */
-    smooth_count(SMOOTH_COUNT_OUT, 1);
+       the smoother declined. (Summed, see per_frame_answers_reset.) */
+    ++g_smooth_out;
+}
+
+/* clip space -> screen space in place: to_screen's own arithmetic on x, y
+   and z, the rest of the vertex as it is. */
+inline void to_screen_in_place(GxVertex &o) {
+    const float iw = (std::fabs(o.w) > 1e-6f) ? 1.0f / o.w : 0.0f;
+    o.x = (o.x * iw + 1.0f) * 0.5f * g.vp_w + g.vp_x;
+    o.y = (1.0f - (o.y * iw + 1.0f) * 0.5f) * g.vp_h + g.vp_y;
+    o.z = (o.z * iw + 1.0f) * 0.5f;
+}
+
+/* THE UNCLIPPED TRIANGLE, built where it lands: what emit_tri_near does when
+   no vertex is behind the near plane (to_screen on each vertex, then
+   push_screen_tri), without the four intermediate copies of every vertex
+   that path makes. `persp` is emit_tri_near's own, the negation of
+   push_screen_tri's ortho test. */
+void push_unclipped_tri(const GxVertex &a, const GxVertex &b, const GxVertex &c,
+                        bool persp) {
+    if (!persp) g_frame_ortho = true;
+    g.tris.emplace_back();
+    GxTriangle &t = g.tris.back();
+    t.v[0] = a; t.v[1] = b; t.v[2] = c;
+    to_screen_in_place(t.v[0]);
+    to_screen_in_place(t.v[1]);
+    to_screen_in_place(t.v[2]);
+    fill_tri_state(t);
+    ++g_smooth_out;
 }
 
 // Does the active projection put a near plane in front of the camera? It
@@ -897,6 +952,11 @@ void emit_tri_near(const GxVertex &a, const GxVertex &b, const GxVertex &c) {
     // divide is the ordinary one.
     const bool persp = g.proj.m[3] != 0.0f || g.proj.m[7] != 0.0f ||
                        g.proj.m[11] != 0.0f;
+    if (near_dist(a, persp) >= 0.0f && near_dist(b, persp) >= 0.0f &&
+        near_dist(c, persp) >= 0.0f) {
+        push_unclipped_tri(a, b, c, persp);   // every vertex in front: no clip
+        return;
+    }
     GxVertex in[3] = {a, b, c};
     GxVertex outp[4];
     int n = 0;
@@ -1696,11 +1756,11 @@ int smooth_try(const GxVertex &a, const GxVertex &b, const GxVertex &c,
 
 void emit_tri(const GxVertex &a, const GxVertex &b, const GxVertex &c,
               const GxRaw &ra, const GxRaw &rb, const GxRaw &rc) {
-    smooth_count(SMOOTH_COUNT_IN, 1);
+    ++g_smooth_in;   // SMOOTH_COUNT_IN, summed (see per_frame_answers_reset)
     /* OFF IS ONE COMPARE. smooth_level() is a load of a file-scope int that
        walk_window sets once at boot; with the setting absent it is 0 and this
        function is the same call it always was. */
-    if (smooth_level() > 0) {
+    if (smooth_lvl() > 0) {
         const int pf = smooth_prof_on();
         const long long t0 = pf ? smooth_prof_ticks() : 0;
         const int took = smooth_try(a, b, c, ra, rb, rc);
@@ -1806,16 +1866,18 @@ void vertex(int16_t x, int16_t y, int16_t z) {
     /* The raw half of the vertex, for the shape store. With the setting
        absent it is filled with a pair of generations that can never match,
        so the store is unreachable rather than merely unused. */
-    GxRaw r = g_raw_dead;
-    if (smooth_level() > 0) {
-        mtx_gen_update();
-        r.x = x; r.y = y; r.z = z;
-        r.nrm = g.nrm_raw;
-        r.mgen = g_mtx_gen;
-        r.ngen = g.nrm_gen;
-        r.has_normal = (uint8_t)(g.normal_live ? 1 : 0);
+    if (smooth_lvl() <= 0) {
+        push_vertex(project(x, y, z), 0);
+        return;
     }
-    push_vertex(project(x, y, z), smooth_level() > 0 ? &r : 0);
+    GxRaw r = g_raw_dead;
+    mtx_gen_update();
+    r.x = x; r.y = y; r.z = z;
+    r.nrm = g.nrm_raw;
+    r.mgen = g_mtx_gen;
+    r.ngen = g.nrm_gen;
+    r.has_normal = (uint8_t)(g.normal_live ? 1 : 0);
+    push_vertex(project(x, y, z), &r);
 }
 
 // --- command execution ------------------------------------------------------
@@ -2073,7 +2135,7 @@ void exec(uint8_t cmd, const uint32_t *p, int np) {
                what one particular matrix made of it. Behind the level check,
                so a run with the setting absent pays one compare on a
                file-scope int and nothing else. */
-            if (smooth_level() > 0) {
+            if (smooth_lvl() > 0) {
                 mtx_gen_update();
                 g.nrm_raw = p[0] & 0x3FFFFFFFu;
                 g.nrm_gen = g_mtx_gen;
@@ -2330,14 +2392,22 @@ int g_queued = 0, g_qpos = 0;
 uint32_t g_params[32];
 int g_have = 0;
 
+/* param_count as a table, for the per-word state machine below. */
+struct ParamCounts {
+    uint8_t n[256];
+    ParamCounts() { for (int i = 0; i < 256; ++i) n[i] = (uint8_t)param_count((uint8_t)i); }
+};
+const ParamCounts g_param_counts;
+
 void feed(uint32_t word) {
+    const uint8_t *const pc = g_param_counts.n;
     if (g_queued == 0) {                       // expecting a command word
         for (int i = 0; i < 4; ++i) g_queue[i] = static_cast<uint8_t>(word >> (i * 8));
         g_queued = 4;
         g_qpos = 0;
         g_have = 0;
         // Commands taking no parameters execute immediately.
-        while (g_qpos < g_queued && param_count(g_queue[g_qpos]) == 0) {
+        while (g_qpos < g_queued && pc[g_queue[g_qpos]] == 0) {
             exec(g_queue[g_qpos], nullptr, 0);
             ++g_qpos;
         }
@@ -2346,11 +2416,11 @@ void feed(uint32_t word) {
     }
     const uint8_t cmd = g_queue[g_qpos];
     g_params[g_have++] = word;
-    if (g_have >= param_count(cmd)) {
+    if (g_have >= pc[cmd]) {
         exec(cmd, g_params, g_have);
         g_have = 0;
         ++g_qpos;
-        while (g_qpos < g_queued && param_count(g_queue[g_qpos]) == 0) {
+        while (g_qpos < g_queued && pc[g_queue[g_qpos]] == 0) {
             exec(g_queue[g_qpos], nullptr, 0);
             ++g_qpos;
         }
@@ -3009,6 +3079,7 @@ static void smooth_trihash_frame() {
 }
 
 void gx_reset() {
+    per_frame_answers_reset();
     ++g_resets;
     g_frame_ortho = false;
     grid_stats_frame();
@@ -3229,6 +3300,13 @@ const GxTriangle *gx_polygons(size_t &count) {
     return g.tris.empty() ? nullptr : g.tris.data();
 }
 
+const GxTriangle *gx_take_triangles(std::vector<GxTriangle> &into) {
+    const GxTriangle *had = g.tris.data();
+    into.swap(g.tris);
+    g.tris.clear();
+    return had;
+}
+
 /* SM64DS_MAT_LOG=1: once, after the first full frame is assembled, the
    LIGHTING side of the same picture -- every distinct POLYGON_ATTR, DIF_AMB
    and SPE_EMI word that reached exec(), the light table the engine is
diff --git a/port/ntr/include/ntr/gx.h b/port/ntr/include/ntr/gx.h
index 2d941f816..2f77ee029 100644
--- a/port/ntr/include/ntr/gx.h
+++ b/port/ntr/include/ntr/gx.h
@@ -19,6 +19,7 @@
 #define NTR_GX_H
 
 #include <stdint.h>
+#include <vector>
 
 #include "ntr/ppu.h"
 
@@ -273,6 +274,13 @@ const GxTriangle *gx_polygons(size_t &count);
 // The polygon count only: the triangles the list holds plus the ones its kept
 // smoothed grids stand for, without turning the grids back into triangles.
 size_t gx_polygon_count();
+// Hand the triangle list over: `into` and the list are swapped, so `into` now
+// owns the frame's triangles (they survive the next gx_reset) and the list
+// carries on in `into`'s old buffer, emptied, its capacity kept. Returns the
+// data pointer the list had, which is what gx_render handed a backend in
+// GxGpuFrame::tris. For a backend that draws a kept frame after the next
+// frame's command stream has begun (the 3DS port presents on another core).
+const GxTriangle *gx_take_triangles(std::vector<GxTriangle> &into);
 
 // Bumped every time gx_invalidate_textures throws the decode cache away, so a
 // backend holding copies of those textures knows to drop them.
-- 
