From 69d697add9e890aac12d882155b3e5b0068e06c3 Mon Sep 17 00:00:00 2001
From: sm64ds-3ds <244728604+ethanseagull@users.noreply.github.com>
Date: Mon, 19 Oct 2026 19:36:10 -0700
Subject: [PATCH] ntr: the record tags each id with its display list and matrix
 shape

GxRecRaw now carries src, the display list the id's vertices streamed
from (run interp1's gx_dma_source; 0 when fed by hand), and shape, a hash
of the matrix-parameter commands and modes since the last vertex (run
interp1's IpGroup::shape). port3ds's interp3ds keys its pairing by them,
as SmoothMotion keys its draw groups. Only a recorded frame pays: one
test of g_rec.on per command.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 port/ntr/gx.cpp           | 23 +++++++++++++++++++++++
 port/ntr/include/ntr/gx.h |  3 +++
 2 files changed, 26 insertions(+)

diff --git a/port/ntr/gx.cpp b/port/ntr/gx.cpp
index caf3b06ea..497863e8e 100644
--- a/port/ntr/gx.cpp
+++ b/port/ntr/gx.cpp
@@ -1797,6 +1797,8 @@ struct RecMtx {
     Mat pos, proj;
     int vp[4];             // g.vp_x, vp_y, vp_w, vp_h
     int sprite;            // g_menu_sprite
+    uint32_t src;          // the display list streaming when it was made (0: by hand)
+    uint32_t shape;        // Rec::shape then
 };
 struct RecRun {
     uint32_t first;        // its first triangle
@@ -1829,8 +1831,21 @@ struct Rec {
     std::vector<RecMtx> mtx;
     std::vector<uint32_t> strip;    // lean: the primitive's record indices
     std::vector<GxTriangle> view;   // lean: gx_polygons' copy
+    /* THE MATRIX SHAPE (interp3ds' pairing): a hash of the matrix-parameter
+       commands (LOAD, MULT, SCALE, TRANS) and their modes since the last
+       vertex, run interp1's IpGroup::shape. Two ids of one key with
+       different shapes are different kinds of draw. */
+    uint32_t shape;
+    int geom;              // a vertex came since the last matrix command
 };
 Rec g_rec;
+constexpr uint32_t REC_SHAPE0 = 2166136261u;
+inline void rec_cmd(uint8_t cmd) {
+    if (cmd < 0x16 || cmd > 0x1C) return;
+    Rec &R = g_rec;
+    if (R.geom) { R.shape = REC_SHAPE0; R.geom = 0; }
+    R.shape = (R.shape ^ (uint32_t)(cmd | ((g.mode & 3) << 8))) * 16777619u;
+}
 enum { REC_OK = 0, REC_IDS, REC_STRIP };
 int g_rec_lean_cfg;   // gx_record_configure
 
@@ -1856,6 +1871,8 @@ void rec_frame_begin() {
     R.mtx.clear();
     R.strip.clear();
     R.bad = REC_OK;
+    R.shape = REC_SHAPE0;
+    R.geom = 0;
     R.on = rec_wanted() && smooth_lvl() <= 0 && !g_ip_armed && !g_stargeo.on;
     R.lean = R.on && g_rec_lean_cfg;
     R.listed = 0;
@@ -1879,8 +1896,11 @@ inline void rec_vertex(int16_t x, int16_t y, int16_t z, bool new_id) {
         m.proj = g.proj;
         m.vp[0] = g.vp_x; m.vp[1] = g.vp_y; m.vp[2] = g.vp_w; m.vp[3] = g.vp_h;
         m.sprite = g_menu_sprite;
+        m.src = g_ip_dma_src;
+        m.shape = R.shape;
         R.mtx.push_back(m);
     }
+    R.geom = 1;
     if (R.v.size() >= 0xFFFF) { rec_stop(REC_IDS); return; }   // 16-bit indices
     if (g.strip.empty()) R.strip_base = (uint32_t)R.v.size();
     /* the id, and in bit 15 whether its projection is a perspective one (the
@@ -2433,6 +2453,7 @@ int param_count(uint8_t cmd);   /* defined below; the trap needs it */
 void exec(uint8_t cmd, const uint32_t *p, int np) {
     (void)np;
     if (g_ip_rec) ip_push(IPK_CMD, cmd, np, p);
+    if (g_rec.on) rec_cmd(cmd);
     if (!g_ip_replaying) {
         ++g_cmd_n[cmd];
         if (cmd == 0x50) g_swap_param = p[0];
@@ -3909,6 +3930,8 @@ int gx_take_record(GxRecord &into) {
         if (into.want_raw) {
             std::memcpy(into.raw[k].pos, m.pos.m, sizeof m.pos.m);
             std::memcpy(into.raw[k].pws, pws.m, sizeof pws.m);
+            into.raw[k].src = m.src;
+            into.raw[k].shape = m.shape;
         }
         for (int i = 0; i < 12; ++i) t.m[i] *= FX12;   // rows 0-2: the raw coordinates' scale
         std::memcpy(into.mtx[k].m, t.m, sizeof t.m);
diff --git a/port/ntr/include/ntr/gx.h b/port/ntr/include/ntr/gx.h
index fd6bdd4cf..d7ed54d98 100644
--- a/port/ntr/include/ntr/gx.h
+++ b/port/ntr/include/ntr/gx.h
@@ -218,9 +218,12 @@ struct GxRecMatrix {
 // m = pos x pws with rows 0-2 times 1/4096, pos the position matrix (model to
 // view, the DS's row-vector form), pws the projection, widen and viewport
 // map gx_take_record folded in.
+// src is the display list the id's vertices streamed from (0: fed by hand)
+// and shape a hash of the matrix commands before them (run interp1's keys).
 struct GxRecRaw {
     float pos[16];
     float pws[16];
+    uint32_t src, shape;
 };
 struct GxRecord {
     std::vector<GxRecVertex> v;
-- 
