From b66dbbae7646b55bcc5f008ac47542a2202d61ae Mon Sep 17 00:00:00 2001
From: sm64ds-3ds <244728604+ethanseagull@users.noreply.github.com>
Date: Sun, 25 Oct 2026 09:18:25 -0700
Subject: [PATCH] ntr: the divider's 64/32 divides past 31-bit quotients
 without a library divide

The unit runs on every operand store, so most of its 64-bit library divides
were of a new numerator by the old denominator. div64_by_32_long: the high
word by a 32-bit divide, the rest by the VFP's, corrected exactly (checked
against exact division over 1M cases).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 port/ntr/io.cpp | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/port/ntr/io.cpp b/port/ntr/io.cpp
index 3ac1b0d79..8fd518d3e 100644
--- a/port/ntr/io.cpp
+++ b/port/ntr/io.cpp
@@ -230,6 +230,30 @@ static int64_t div64_by_32_vfp(int64_t n, int64_t d, int64_t &rem) {
     return q;
 }
 
+/* n / d for a 32-bit d and ANY quotient (past div64_by_32_vfp's 31 bits), as C
+   truncates it: on the magnitudes, the high word by a 32-bit divide, then the
+   remainder and the low word (under |d| * 2^32, so a quotient under 2^32 that
+   the double has to within 2^-21) by the VFP's divide, corrected by the exact
+   remainder; the signs put back last. The unit runs on every operand store,
+   so most of the 64-bit library divides it did were of a new numerator by the
+   last denominator (a quotient past 32 bits), before the new one landed. */
+static int64_t div64_by_32_long(int64_t n, int64_t d, int64_t &rem) {
+    const uint64_t un = n < 0 ? 0 - static_cast<uint64_t>(n) : static_cast<uint64_t>(n);
+    const uint32_t ud = d < 0 ? 0u - static_cast<uint32_t>(d) : static_cast<uint32_t>(d);
+    const uint32_t hi = static_cast<uint32_t>(un >> 32), lo = static_cast<uint32_t>(un);
+    const uint32_t qh = hi / ud, r = hi - qh * ud;
+    const uint64_t low = static_cast<uint64_t>(r) << 32 | lo;   // < ud * 2^32
+    const double est = (static_cast<double>(r) * 4294967296.0 + static_cast<double>(lo)) /
+                       static_cast<double>(ud);
+    uint32_t ql = est >= 4294967295.0 ? 0xFFFFFFFFu : static_cast<uint32_t>(est);
+    int64_t rr = static_cast<int64_t>(low - static_cast<uint64_t>(ql) * ud);
+    while (rr < 0) { --ql; rr += ud; }
+    while (rr >= static_cast<int64_t>(ud)) { ++ql; rr -= ud; }
+    const uint64_t uq = static_cast<uint64_t>(qh) << 32 | ql;
+    rem = n < 0 ? -rr : rr;
+    return (n < 0) != (d < 0) ? static_cast<int64_t>(0 - uq) : static_cast<int64_t>(uq);
+}
+
 /* The same for any n and d a double holds exactly (under 2^53 each way): the
    title's skinned faces divide 64 by 64 (or 64 by 32 past a 32-bit quotient),
    ~3% of an Azahar title frame through __udivmoddi4. rem = INT64_MIN: not
@@ -292,6 +316,8 @@ void run_divide() {
            double divide and an exact remainder correction: the same quotient
            and remainder as below, without a 64-bit library divide (~10% of
            an Azahar file-select frame through __udivmoddi4). */
+    } else if (d == static_cast<int32_t>(d) && !(n == INT64_MIN && d == -1)) {
+        quot = div64_by_32_long(n, d, rem);
     } else if (!(n == INT64_MIN && d == -1) && (quot = div64_vfp(n, d, rem), rem != INT64_MIN)) {
     } else {
         quot = n / d;
