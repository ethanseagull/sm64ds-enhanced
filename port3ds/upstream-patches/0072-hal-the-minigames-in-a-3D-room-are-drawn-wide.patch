From 11005452c2ff7418856ca3a7b01b21e63291c027 Mon Sep 17 00:00:00 2001
From: sm64ds-3ds <244728604+ethanseagull@users.noreply.github.com>
Date: Fri, 30 Oct 2026 10:45:02 -0700
Subject: [PATCH] hal: the minigames in a 3D room are drawn wide

Scenes 362, 363, 379, 381, 382, 383, 388 and 389 have a top screen that is all 3D room under the HUD's sprites, and they now keep the wide field like a level. Every other minigame's top screen is a 2D picture drawn for 256 columns and stays at the DS's 4:3 (measured scene by scene, 2026-10-30).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 port/hal/scene_boot.cpp | 26 ++++++++++++++++++++++----
 1 file changed, 22 insertions(+), 4 deletions(-)

diff --git a/port/hal/scene_boot.cpp b/port/hal/scene_boot.cpp
index e1ac387ff..53037733f 100644
--- a/port/hal/scene_boot.cpp
+++ b/port/hal/scene_boot.cpp
@@ -6005,11 +6005,30 @@ extern "C" int port_scene_layout_two_screen(int scene)
             (ntr::widescreen && !scene_layout_mg_wide()));
 }
 
+/* THE MINIGAMES WHOSE TOP SCREEN IS A 3D ROOM, drawn wide like a level: the
+   casino's card and Memory games under Luigi (362, 363, 379, 381, 382, 388),
+   the roulette (383) and the 3D ESP lake (389). Their whole top screen is the
+   3D scene with the HUD's sprites over it, and the HUD keeps to the picture's
+   edges at any width. Every other minigame's top screen is a 2D picture drawn
+   for 256 columns (or a 3D model over one, 361, 367, 390), and wide only
+   shows past its edge. The 3DS's 400x240 top screen, measured scene by scene
+   (2026-10-30). */
+static bool scene_layout_wide_3d(int scene)
+{
+    switch (scene) {
+    case 362: case 363: case 379: case 381: case 382: case 383: case 388: case 389:
+        return true;
+    default:
+        return false;
+    }
+}
+
 /* the presentation field for the same scene: every scene is the DS's own 4:3
-   centred in the wide framebuffer, only a level keeps the wide field */
+   centred in the wide framebuffer, only a level (and a minigame in a 3D room,
+   above) keeps the wide field */
 extern "C" int port_scene_layout_native(int scene)
 {
-    return scene >= 0 && !scene_layout_mg_wide();
+    return scene >= 0 && !scene_layout_mg_wide() && !scene_layout_wide_3d(scene);
 }
 
 /* THE LAYOUT, PROPOSED FROM THE ROM'S OWN PREDICATE. src/IsMinigameActorID.c
@@ -6082,7 +6101,6 @@ extern "C" void port_scene_layout_propose(void)
        SM64DS_MG_WIDE=1 puts the whole widescreen treatment back for one run --
        both the field below and this layout term -- so the before and the after
        can be captured off ONE binary. Unset is the ruling. */
-    const bool mg_wide = scene_layout_mg_wide();
     const int two_screen = port_scene_layout_two_screen(scene);
     /* AND THE PRESENTATION WIDTH, decided in the same place and from the same
        predicate, because it is the same kind of fact: a per-scene answer the
@@ -6108,7 +6126,7 @@ extern "C" void port_scene_layout_propose(void)
        SM64DS_MG_WIDE=1 puts the treatment back for one run, for both halves,
        so the before and the after can be captured off ONE binary instead of
        two. Unset is the ruling. */
-    ntr::set_present_native(scene >= 0 && !mg_wide);
+    ntr::set_present_native(port_scene_layout_native(scene) != 0);
     hal_sub_screen_set_stacked(two_screen);
     /* Say the decision once, on the run that made it, beside the [sub] layout
        line hal/sub_screen.cpp prints for the other half. "the wide field on a
-- 
