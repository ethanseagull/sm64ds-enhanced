From 64a9e34f5b4a10d3ab59de32b6acec317a4b7a79 Mon Sep 17 00:00:00 2001
From: sm64ds-3ds <244728604+ethanseagull@users.noreply.github.com>
Date: Tue, 20 Oct 2026 11:40:36 -0700
Subject: [PATCH] hal: the composite memo keeps two saved frames; a probe for
 why it missed

5o's pause on hardware still stuttered. SM64DS_COMPA_MEMO_WHY=1 (new: the
first input that differed, on stderr, each time a saved frame is tried and
missed) showed why: a sprite on the pause screen bounces between two rows
every few frames (OAM entry 0, y 162 <-> 164 in the castle's pause), so with
one saved frame each bounce composed again. The memo now keeps two saved
frames, tries the most recently used first, records over the matched or the
least recently used one, and compares the spans last to first (OAM and the
OBJ tiles before the BG tile data), as the scan cache does.

Azahar stress-pause: 186 of 189 pause frames replayed (was 163), the
compositor 8.1 -> 1.6-3.1 ms a frame, the tick 23 -> 16.5-18 ms. Verify on
every held frame of all 34 cases: 9,575 matched, 0 differed; sequence shots
through the pause identical with the memo off and on.
---
 port/hal/message_compositor.cpp | 213 +++++++++++++++++++++++---------
 1 file changed, 152 insertions(+), 61 deletions(-)

diff --git a/port/hal/message_compositor.cpp b/port/hal/message_compositor.cpp
index bce317da0..6485ed907 100644
--- a/port/hal/message_compositor.cpp
+++ b/port/hal/message_compositor.cpp
@@ -3375,11 +3375,18 @@ unsigned memo_cells()
     }
     return (unsigned)v;
 }
-struct Memo {
-    bool on;                       // the host asked (port_message_composite_memo)
-    bool valid;                    // the saved frame may be replayed
+/* TWO SAVED FRAMES, the least recently used one replaced. A pause screen is
+   not quite still: a sprite on it bounces between two rows every few frames
+   (OAM entry 0, y 162 <-> 164, in the castle's pause), and with one saved
+   frame each bounce composed again -- most of 5o's remaining pause stutter on
+   hardware. With two, both states are kept. */
+constexpr int kMemoFrames = 2;
+struct MemoFrame {
+    bool valid;                    // may be replayed
+    unsigned used;                 // g_memo.clock when last recorded or replayed
     std::vector<uint32_t> scal;    // its scalars
     std::vector<MemoSpan> spans;   // its memory spans, sorted and merged
+    std::vector<size_t> offs;      // each span's offset in bytes
     std::vector<uint8_t> bytes;    // their contents, span after span
     std::vector<MemoBlit> blits;   // its blit, in order
     std::vector<uint8_t> bm;       // g_bm's rows as it left them (bm_live)
@@ -3387,9 +3394,14 @@ struct Memo {
     bool bm_live, bm_card, bm_shown3d, bm_clear_opaque, behind;
     uint32_t kept3d, buried3d;
     unsigned cells;                // its blit cells
+};
+struct Memo {
+    bool on;                       // the host asked (port_message_composite_memo)
+    unsigned clock;
+    MemoFrame frame[kMemoFrames];
     // the frame being composited
     bool rec;                      // it may be recorded
-    bool would;                    // verify: it matched the saved inputs
+    int would;                     // verify: the saved frame its inputs matched, else -1
     bool behind_now;
     unsigned cells_now, last_cells;
     std::vector<uint32_t> cur_scal;
@@ -3491,82 +3503,147 @@ void memo_inputs(uint32_t dispcnt, std::vector<uint32_t> &scal, std::vector<Memo
     sp.resize(n);
 }
 
-bool memo_same()
+/* SM64DS_COMPA_MEMO_WHY=1: each frame the memo is tried and misses, which
+   input differed (the first one found), on stderr -- what an animation
+   changes from frame to frame. */
+int memo_why_on()
+{
+    static int v = -1;
+    if (v < 0) {
+        const char *e = std::getenv("SM64DS_COMPA_MEMO_WHY");
+        v = (e && *e && *e != '0') ? 1 : 0;
+    }
+    return v;
+}
+
+bool memo_same(const MemoFrame &f)
 {
-    if (g_memo.cur_scal != g_memo.scal || g_memo.cur_spans.size() != g_memo.spans.size()) return false;
-    size_t off = 0;
-    for (size_t i = 0; i < g_memo.spans.size(); ++i) {
-        const MemoSpan &a = g_memo.cur_spans[i], &b = g_memo.spans[i];
-        if (a.lo != b.lo || a.hi != b.hi) return false;
+    const bool why = memo_why_on() != 0;
+    if (g_memo.cur_scal != f.scal) {
+        if (why) {
+            size_t i = 0;
+            while (i < f.scal.size() && i < g_memo.cur_scal.size() && f.scal[i] == g_memo.cur_scal[i]) ++i;
+            std::fprintf(stderr, "[memo-why] scalar %u: %08x -> %08x (%u scalars)\n", (unsigned)i,
+                         i < f.scal.size() ? (unsigned)f.scal[i] : 0u,
+                         i < g_memo.cur_scal.size() ? (unsigned)g_memo.cur_scal[i] : 0u,
+                         (unsigned)g_memo.cur_scal.size());
+        }
+        return false;
+    }
+    if (g_memo.cur_spans.size() != f.spans.size()) {
+        if (why) std::fprintf(stderr, "[memo-why] span count %u -> %u\n", (unsigned)f.spans.size(),
+                              (unsigned)g_memo.cur_spans.size());
+        return false;
+    }
+    for (size_t i = 0; i < f.spans.size(); ++i) {
+        const MemoSpan &a = g_memo.cur_spans[i], &b = f.spans[i];
+        if (a.lo != b.lo || a.hi != b.hi) {
+            if (why) std::fprintf(stderr, "[memo-why] span %u moved: [%08x,%08x) -> [%08x,%08x)\n", (unsigned)i,
+                                  (unsigned)b.lo, (unsigned)b.hi, (unsigned)a.lo, (unsigned)a.hi);
+            return false;
+        }
+    }
+    /* LAST TO FIRST, as the scan cache compares: the spans are sorted by
+       address, so OAM and the OBJ tiles (what a moving sprite changes) are at
+       the end and the BG tile data in the middle; a frame that differs mostly
+       says so in its first kilobyte this way */
+    for (size_t i = f.spans.size(); i-- > 0;) {
+        const MemoSpan &a = g_memo.cur_spans[i];
         const size_t len = a.hi - a.lo;
-        if (std::memcmp(reinterpret_cast<const void *>(a.lo), g_memo.bytes.data() + off, len) != 0)
+        const uint8_t *now = reinterpret_cast<const uint8_t *>(a.lo), *was = f.bytes.data() + f.offs[i];
+        if (std::memcmp(now, was, len) != 0) {
+            if (why) {
+                size_t k = 0, n = 0;
+                while (k < len && now[k] == was[k]) ++k;
+                for (size_t q = k; q < len; ++q) n += now[q] != was[q];
+                const size_t q8 = k & ~(size_t)7;
+                std::fprintf(stderr, "[memo-why] memory %08x: %u bytes differ (span [%08x,%08x)); "
+                             "its 8 bytes now %02x%02x%02x%02x %02x%02x%02x%02x was %02x%02x%02x%02x %02x%02x%02x%02x\n",
+                             (unsigned)(a.lo + k), (unsigned)n, (unsigned)a.lo, (unsigned)a.hi,
+                             now[q8], now[q8 + 1], now[q8 + 2], now[q8 + 3], now[q8 + 4], now[q8 + 5],
+                             now[q8 + 6], now[q8 + 7], was[q8], was[q8 + 1], was[q8 + 2], was[q8 + 3],
+                             was[q8 + 4], was[q8 + 5], was[q8 + 6], was[q8 + 7]);
+            }
             return false;
-        off += len;
+        }
     }
     return true;
 }
 
-void memo_replay(ntr::Framebuffer &fb)
+void memo_replay(ntr::Framebuffer &fb, MemoFrame &f)
 {
-    for (const MemoBlit &b : g_memo.blits)
+    for (const MemoBlit &b : f.blits)
         blit_ov_cell(fb, b.hx0, b.hx1 - b.hx0, b.hy0, b.hy1, b.word, false, 0);
-    g_bm_live = g_memo.bm_live;
-    g_bm_card = g_memo.bm_card;
-    g_bm_shown3d = g_memo.bm_shown3d;
-    g_bm_clear_opaque = g_memo.bm_clear_opaque;
-    if (g_memo.bm_live && g_bm) std::memcpy(g_bm, g_memo.bm.data(), g_memo.bm.size());
-    if (g_memo.behind) ntr::gx_card_note_behind();
-    g_kept3d = g_memo.kept3d;
-    g_buried3d = g_memo.buried3d;
-    g_pic_sig = g_memo.sig;
+    g_bm_live = f.bm_live;
+    g_bm_card = f.bm_card;
+    g_bm_shown3d = f.bm_shown3d;
+    g_bm_clear_opaque = f.bm_clear_opaque;
+    if (f.bm_live && g_bm) std::memcpy(g_bm, f.bm.data(), f.bm.size());
+    if (f.behind) ntr::gx_card_note_behind();
+    g_kept3d = f.kept3d;
+    g_buried3d = f.buried3d;
+    g_pic_sig = f.sig;
     g_pic_sig_ok = true;
-    g_memo.last_cells = g_memo.cells;
+    g_memo.last_cells = f.cells;
+    f.used = ++g_memo.clock;
 }
 
 /* the end of a composite that may be recorded: check it against the saved
-   frame when verifying, then save it if it is plain */
+   frame its inputs matched when verifying, then save it if it is plain --
+   over that frame, else over the least recently used one */
 void memo_finish()
 {
     if (!g_memo.rec) return;
     g_memo.rec = false;
     const size_t bm_len = (size_t)ntr::SCREEN_W * (size_t)ntr::active_h;
-    if (g_memo.would) {
-        const bool same = g_pic_sig_ok && g_pic_sig == g_memo.sig && g_bm_live == g_memo.bm_live &&
-                          g_bm_card == g_memo.bm_card && g_bm_shown3d == g_memo.bm_shown3d &&
-                          g_bm_clear_opaque == g_memo.bm_clear_opaque &&
-                          g_memo.behind_now == g_memo.behind && g_kept3d == g_memo.kept3d &&
-                          g_buried3d == g_memo.buried3d &&
-                          (!g_bm_live || (g_bm && g_memo.bm.size() == bm_len &&
-                                          std::memcmp(g_bm, g_memo.bm.data(), bm_len) == 0));
+    if (g_memo.would >= 0) {
+        const MemoFrame &f = g_memo.frame[g_memo.would];
+        const bool same = g_pic_sig_ok && g_pic_sig == f.sig && g_bm_live == f.bm_live &&
+                          g_bm_card == f.bm_card && g_bm_shown3d == f.bm_shown3d &&
+                          g_bm_clear_opaque == f.bm_clear_opaque &&
+                          g_memo.behind_now == f.behind && g_kept3d == f.kept3d &&
+                          g_buried3d == f.buried3d &&
+                          (!g_bm_live || (g_bm && f.bm.size() == bm_len &&
+                                          std::memcmp(g_bm, f.bm.data(), bm_len) == 0));
         if (!same) ++g_cz.memo_bad;
     }
     if (!g_pic_sig_ok || !ntr::gx_card_overlay_active() || g_arrow_n || !g_hud_fixed ||
-        ntr::gx_aa_preimage() || (g_bm_live && !g_bm)) {
-        g_memo.valid = false;
+        ntr::gx_aa_preimage() || (g_bm_live && !g_bm))
         return;
+    int s = g_memo.would;
+    if (s < 0) {
+        s = 0;
+        for (int i = 1; i < kMemoFrames; ++i) {
+            const MemoFrame &a = g_memo.frame[i], &b = g_memo.frame[s];
+            if (!a.valid ? b.valid || a.used < b.used : b.valid && a.used < b.used) s = i;
+        }
     }
-    g_memo.scal.swap(g_memo.cur_scal);
-    g_memo.spans.swap(g_memo.cur_spans);
-    g_memo.blits.swap(g_memo.cur_blits);
+    MemoFrame &f = g_memo.frame[s];
+    f.scal.swap(g_memo.cur_scal);
+    f.spans.swap(g_memo.cur_spans);
+    f.blits.swap(g_memo.cur_blits);
+    f.offs.resize(f.spans.size());
     size_t total = 0;
-    for (const MemoSpan &s : g_memo.spans) total += s.hi - s.lo;
-    g_memo.bytes.resize(total);
-    size_t off = 0;
-    for (const MemoSpan &s : g_memo.spans) {
-        std::memcpy(g_memo.bytes.data() + off, reinterpret_cast<const void *>(s.lo), s.hi - s.lo);
-        off += s.hi - s.lo;
+    for (size_t i = 0; i < f.spans.size(); ++i) {
+        f.offs[i] = total;
+        total += f.spans[i].hi - f.spans[i].lo;
     }
-    g_memo.sig = g_pic_sig;
-    g_memo.bm_live = g_bm_live;
-    g_memo.bm_card = g_bm_card;
-    g_memo.bm_shown3d = g_bm_shown3d;
-    g_memo.bm_clear_opaque = g_bm_clear_opaque;
-    if (g_bm_live) g_memo.bm.assign(g_bm, g_bm + bm_len);
-    g_memo.behind = g_memo.behind_now;
-    g_memo.kept3d = g_kept3d;
-    g_memo.buried3d = g_buried3d;
-    g_memo.cells = g_memo.cells_now;
-    g_memo.valid = true;
+    f.bytes.resize(total);
+    for (size_t i = 0; i < f.spans.size(); ++i)
+        std::memcpy(f.bytes.data() + f.offs[i], reinterpret_cast<const void *>(f.spans[i].lo),
+                    f.spans[i].hi - f.spans[i].lo);
+    f.sig = g_pic_sig;
+    f.bm_live = g_bm_live;
+    f.bm_card = g_bm_card;
+    f.bm_shown3d = g_bm_shown3d;
+    f.bm_clear_opaque = g_bm_clear_opaque;
+    if (g_bm_live) f.bm.assign(g_bm, g_bm + bm_len);
+    f.behind = g_memo.behind_now;
+    f.kept3d = g_kept3d;
+    f.buried3d = g_buried3d;
+    f.cells = g_memo.cells_now;
+    f.used = ++g_memo.clock;
+    f.valid = true;
     ++g_cz.memo_recs;
 }
 
@@ -3729,24 +3806,37 @@ extern "C" void port_message_composite_engine_a(void *fbp)
     {
         const unsigned last = g_memo.last_cells;
         g_memo.last_cells = 0;
-        g_memo.rec = g_memo.would = g_memo.behind_now = false;
+        g_memo.rec = g_memo.behind_now = false;
+        g_memo.would = -1;
         g_memo.cells_now = 0;
         g_memo.cur_blits.clear();
+        if (memo_why_on() && g_memo.on && last < memo_cells() && last > 0)
+            std::fprintf(stderr, "[memo-why] untried: the last frame blitted %u cells\n", last);
         if (g_memo.on && last >= memo_cells() && !forced_blank && !tw_try && !lc_ov.live &&
             !lc_ov.top_live && ntr::gx_card_overlay_active() && memo_probes_off()) {
             memo_inputs(dispcnt, g_memo.cur_scal, g_memo.cur_spans);
-            if (g_memo.valid && memo_same()) {
+            /* the most recently used saved frame first: a still screen hits it */
+            int order[kMemoFrames];
+            for (int i = 0; i < kMemoFrames; ++i) order[i] = i;
+            std::sort(order, order + kMemoFrames,
+                      [](int a, int b) { return g_memo.frame[a].used > g_memo.frame[b].used; });
+            bool any = false;
+            for (int k = 0; k < kMemoFrames && g_memo.would < 0; ++k) {
+                MemoFrame &f = g_memo.frame[order[k]];
+                if (!f.valid) continue;
+                any = true;
+                if (!memo_same(f)) continue;
                 if (!memo_verify_on()) {
-                    memo_replay(fb);
+                    memo_replay(fb, f);
                     ++g_cz.memo_hits;
                     g_cz.mark(9);   /* the inputs' compare and the replay */
                     return;
                 }
-                g_memo.would = true;
+                g_memo.would = order[k];
                 ++g_cz.memo_match;
             }
+            if (memo_why_on() && !any) std::fprintf(stderr, "[memo-why] no saved frame\n");
             g_memo.rec = true;
-            g_memo.valid = false;   /* until this frame is saved (memo_finish) */
         }
     }
 
@@ -4823,5 +4913,6 @@ extern "C" int port_message_composite_signature(unsigned long long *sig)
 extern "C" void port_message_composite_memo(int on)
 {
     g_memo.on = on != 0;
-    if (!g_memo.on) g_memo.valid = false;
+    if (!g_memo.on)
+        for (MemoFrame &f : g_memo.frame) f.valid = false;
 }
